---
import Layout from "../layouts/Layout.astro";
import LandingNav from "../components/landing/LandingNav.astro";
import LandingHero from "../components/landing/LandingHero.astro";
import LandingCategories from "../components/landing/LandingCategories.astro";
import LandingCustomOrders from "../components/landing/LandingCustomOrders.astro";
import LandingServiceBar from "../components/landing/LandingServiceBar.astro";
import LandingBestSellers from "../components/landing/LandingBestSellers.astro";
import LandingNewArrivals from "../components/landing/LandingNewArrivals.astro";
import LandingFounder from "../components/landing/LandingFounder.astro";
import LandingStoryBanner from "../components/landing/LandingStoryBanner.astro";
import LandingFooter from "../components/landing/LandingFooter.astro";
---

<Layout
  title="Sunflora — Handmade Crochet, Made with Love ♡"
  description="Handmade crochet creations crafted with love. Shop flower bouquets, soft toys, home decor, and custom orders."
>
  <LandingNav />
  <LandingHero />
  <LandingCategories />
  <LandingCustomOrders />
  <LandingServiceBar />
  <LandingBestSellers />
  <LandingNewArrivals />
  <LandingFounder />
  <LandingStoryBanner />
  <LandingFooter />
</Layout>

<script>
  // Lenis smooth scroll
  (async () => {
    const Lenis = (await import("lenis")).default;
    const lenis = new Lenis({
      duration: 1.2,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    });
    const loop = (time: number) => {
      lenis.raf(time);
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  })();

  // Intersection Observer for fade-up animations
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((el) => {
        if (el.isIntersecting) {
          el.target.classList.add("in-view");
          observer.unobserve(el.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: "-60px 0px" },
  );

  document
    .querySelectorAll(".kn-fade-up")
    .forEach((el) => observer.observe(el));
</script>
