---
import { getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import LandingNav from "../components/landing/LandingNav.astro";
import LandingHero from "../components/landing/LandingHero.astro";
import heroBackground from "../assets/crochet_girl.png";

/* The hero image is the LCP element, but it's set as a CSS background inside
   LandingHero.astro — invisible to the browser's preload scanner until the
   stylesheet has been fetched and parsed. Preloading it here (same source +
   params as LandingHero's own getImage call, so Astro resolves to the
   identical cached file) lets the browser start the fetch immediately. */
const heroPreload = await getImage({
  src: heroBackground,
  format: "webp",
  quality: 72,
  width: 1773,
});
import LandingCategories from "../components/landing/LandingCategories.astro";
import LandingCustomOrders from "../components/landing/LandingCustomOrders.astro";
import LandingServiceBar from "../components/landing/LandingServiceBar.astro";
import LandingBestSellers from "../components/landing/LandingBestSellers.astro";
import LandingNewArrivals from "../components/landing/LandingNewArrivals.astro";
import LandingFounder from "../components/landing/LandingFounder.astro";
import LandingFaq from "../components/landing/LandingFaq.astro";
import LandingStoryBanner from "../components/landing/LandingStoryBanner.astro";
import LandingFooter from "../components/landing/LandingFooter.astro";

const site = "https://sunfloracrochet.in";

/* Organization — ties the brand entity together for Knowledge Panel / entity search. */
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${site}/#organization`,
  name: "Sunflora",
  url: site,
  email: "sunflorabyaru@gmail.com",
  founder: { "@type": "Person", name: "Aru Jaiswal" },
  areaServed: { "@type": "Country", name: "India" },
  sameAs: ["https://www.instagram.com/sunfloraa.a/"],
};

/* WebSite — required base entity most other schema (BreadcrumbList, Product) implicitly references. */
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${site}/#website`,
  url: site,
  name: "Sunflora",
  publisher: { "@id": `${site}/#organization` },
  inLanguage: "en-IN",
};
---

<Layout
  title="Sunflora — Handmade Crochet, Made with Love ♡"
  description="Handmade crochet creations crafted with love. Shop flower bouquets, soft toys, home decor, and custom orders."
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroPreload.src} fetchpriority="high" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
      is:inline
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
      is:inline
    />
  </Fragment>

  <LandingNav />
  <LandingHero />
  <LandingCategories />
  <LandingCustomOrders />
  <LandingServiceBar />
  <LandingBestSellers />
  <LandingNewArrivals />
  <LandingFaq />
  <LandingFounder />
  <LandingStoryBanner />
  <LandingFooter />
</Layout>

<script>
  // Lenis smooth scroll
  (async () => {
    const Lenis = (await import("lenis")).default;
    const lenis = new Lenis({
      duration: 1.2,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    });
    const loop = (time: number) => {
      lenis.raf(time);
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  })();

  // Intersection Observer for fade-up animations
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((el) => {
        if (el.isIntersecting) {
          el.target.classList.add("in-view");
          observer.unobserve(el.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: "-60px 0px" },
  );

  document
    .querySelectorAll(".kn-fade-up")
    .forEach((el) => observer.observe(el));
</script>
