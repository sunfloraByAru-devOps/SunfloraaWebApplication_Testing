---
import { Image } from "astro:assets";
import { getContactLinks } from "../../lib/site-content";
import Layout from "../../layouts/Layout.astro";
import LandingNav from "../../components/landing/LandingNav.astro";
import SPIDEY from "../../assets/spiderman.jpg";

import PRODUCT_MAIN from "../../assets/sun_on_desk.png";
import PRODUCT_CLOSE from "../../assets/sun_on_desk_closeup.png";
import PRODUCT_DETAIL from "../../assets/stars.png";
import PRODUCT_LIFE from "../../assets/spiderman.jpg";
import DINO from "../../assets/green-dino.jpg";
import SUNMOON from "../../assets/sun_and_moon.jpg";
import { getGalleryImage, getGridImage, toAbsoluteUrl } from "../../lib/product-images";
import { productSlug } from "../../lib/slug";

import { createClient } from "@supabase/supabase-js";
import ProductBreadcrumb from "../../components/ProductBreadcrumb.astro";
import ProductGallery from "../../components/ProductGallery.astro";
import ProductInfo from "../../components/ProductInfo.astro";
import ProductReviews from "../../components/ProductReviews.astro";
import RelatedProducts from "../../components/RelatedProducts.astro";
import "../../styles/productdetail.css";

/* One source of truth for contact details — see the dashboard. */
const contact = await getContactLinks();

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_KEY,
);

export async function getStaticPaths() {
  const { createClient } = await import("@supabase/supabase-js");
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_KEY,
  );
  const { data } = await supabase
    .from("products")
    .select("name")
    .eq("is_active", true)
    // Deterministic page-generation order (display_order first, nulls last).
    .order("display_order", { ascending: true, nullsFirst: false })
    .order("name", { ascending: true });
  const { productSlug } = await import("../../lib/slug");
  const paths = (data || []).map((p: any) => ({
    params: { slug: productSlug(p.name) },
  }));
  paths.push({ params: { slug: "product-not-found" } });
  return paths;
}

const currentSlug = Astro.params.slug || "sunshine-amigurumi";

// Fetch all active products
const { data: allDbProducts } = await supabase
  .from("products")
  .select(
    `
    *,
    categories(name),
    product_images(storage_path, alt_text, display_order, is_primary),
    product_sizes(label, cm_description, price, mrp, display_order),
    product_colors(name, hex, has_border, display_order),
    product_details(label, value, display_order),
    product_includes(item, display_order),
    customer_insights(label, display_order,
      customer_insight_options(text, pct, display_order)
    ),
    reviews(id, stars, title, body, guest_name,
      profiles!user_id(full_name),
      is_verified, created_at, helpful_count, unhelpful_count, is_approved,
      review_photos(storage_path)
    )
  `,
  )
  .eq("is_active", true)
  // Deterministic order so the emitted product map/JSON is byte-stable.
  .order("display_order", { ascending: true, nullsFirst: false })
  .order("name", { ascending: true });

// Fetch all products_with_image for related sections
const { data: rawRelated } = await supabase
  .from("products_with_image")
  .select(
    "id, name, category_name, base_price, base_mrp, tag, primary_image_path",
  )
  .eq("is_active", true)
  // Related products follow the owner's display_order, with a name tiebreaker.
  .order("display_order", { ascending: true, nullsFirst: false })
  .order("name", { ascending: true });

/* A product with no photo of its own falls back to a stock shot picked by
   category. This used to branch on `id === 1 || id === 6 || ...`, but ids are
   UUIDs, so every comparison was false and every such product got the "Wall
   Hangings" image regardless of what it actually was. */
const getFallbackImage = (categoryName: string | null | undefined) => {
  const category = (categoryName || "").toLowerCase();
  if (category.includes("amigurumi")) return PRODUCT_MAIN.src;
  if (category.includes("keychain")) return SPIDEY.src;
  if (category.includes("hanging")) return PRODUCT_DETAIL.src;
  if (
    category.includes("bouquet") ||
    category.includes("stem") ||
    category.includes("flower")
  ) {
    return PRODUCT_CLOSE.src;
  }
  return SUNMOON.src;
};

const getRelatedProducts = async (currentId: any) => {
  const related = (rawRelated || []).filter((r) => r.id !== currentId).slice(0, 3);

  return Promise.all(
    related.map(async (r) => {
      const fallbackImgSrc = getFallbackImage(r.category_name);
      const optimized = r.primary_image_path ? await getGridImage(r.primary_image_path) : null;

      return {
        id: r.id,
        name: r.name,
        slug: productSlug(r.name),
        tag: r.tag || "",
        price: r.base_price,
        mrp: r.base_mrp,
        img: optimized?.src || fallbackImgSrc,
      };
    }),
  );
};

async function buildGalleryImages(data: any) {
  const rows =
    data.product_images && data.product_images.length > 0
      ? [...data.product_images].sort((a: any, b: any) => a.display_order - b.display_order)
      : [];

  if (rows.length === 0) {
    return [
      { src: getFallbackImage(data.categories?.name), alt: data.name || "", width: 0, height: 0, srcset: "" },
    ];
  }

  return Promise.all(
    rows.map(async (img: any) => {
      const alt = img.alt_text || data.name || "";
      const optimized = await getGalleryImage(img.storage_path);
      return optimized
        ? { src: optimized.src, alt, width: optimized.width, height: optimized.height, srcset: optimized.srcset }
        : { src: getFallbackImage(data.categories?.name), alt, width: 0, height: 0, srcset: "" };
    }),
  );
}

/* ── Reviews ───────────────────────────────────────────────────────────────
   Everything the review section shows is derived from these rows and nothing
   else. Only approved reviews reach the storefront: RLS enforces that for the
   anon key the build uses (supabase/sql/12_product_reviews.sql) and this
   filter is the second lock, so an un-moderated review can never be baked
   into a page even if a policy is later loosened by accident. */
/* The bucket really is `review-photos`. ADMIN_DASHBOARD_PROMPT.md says
   `review-images` and this file used to agree with it, which meant every
   review photo resolved to a public URL in a bucket that does not exist. */
const REVIEW_BUCKET = "review-photos";

const approvedReviewsOf = (rows: any[]) =>
  (rows || [])
    .filter((r: any) => r.is_approved === true)
    .sort(
      (a: any, b: any) =>
        new Date(b.created_at || 0).getTime() -
        new Date(a.created_at || 0).getTime(),
    );

const reviewPhotoUrl = (storagePath: string) =>
  supabase.storage.from(REVIEW_BUCKET).getPublicUrl(storagePath).data.publicUrl;

const reviewDate = (iso: string | null) => {
  const d = new Date(iso || "");
  return Number.isNaN(d.getTime())
    ? ""
    : d.toLocaleDateString("en-GB", {
        day: "numeric",
        month: "short",
        year: "numeric",
      });
};

const mappedProducts: Record<string, any> = {};

if (allDbProducts) {
  for (const data of allDbProducts) {
    const slug = productSlug(data.name);
    const [images, related] = await Promise.all([
      buildGalleryImages(data),
      getRelatedProducts(data.id),
    ]);

    const approved = approvedReviewsOf(data.reviews);
    const starSum = approved.reduce(
      (total: number, r: any) => total + (Number(r.stars) || 0),
      0,
    );
    /* One decimal place, the way the rest of the site quotes a rating. Zero
       reviews means zero — not a placeholder, and not products.avg_rating,
       which is a cached column that can lag a moderation decision. */
    const avgRating = approved.length
      ? Math.round((starSum / approved.length) * 10) / 10
      : 0;

    const mappedReviews = approved.map((r: any) => ({
      id: r.id,
      stars: Number(r.stars) || 0,
      title: r.title || "",
      date: reviewDate(r.created_at),
      helpful: Number(r.helpful_count) || 0,
      unhelpful: Number(r.unhelpful_count) || 0,
      author: r.profiles?.full_name || r.guest_name || "A customer",
      verified: r.is_verified === true,
      body: r.body || "",
      photos: (r.review_photos || [])
        .map((ph: any) => ph?.storage_path)
        .filter(Boolean)
        .map(reviewPhotoUrl),
    }));

    /* The photo strip is the real photos customers attached, de-duplicated
       and capped so one enthusiastic reviewer cannot fill the row. */
    const customerPhotos = [
      ...new Set(mappedReviews.flatMap((r: any) => r.photos)),
    ].slice(0, 24);

    mappedProducts[slug] = {
      id: data.id,
      slug: slug,
      num: String(data.id).padStart(2, "0"),
      name: data.name,
      brand: "Sunflora Studio",
      tag: data.tag,
      tagline: data.tagline || "",
      sku: data.sku || `SFL-${data.id}`,
      rating: avgRating,
      reviewCount: approved.length,
      inStock: data.in_stock,
      price: data.base_price,
      mrp: data.base_mrp,
      description: data.description,
      sizes: (data.product_sizes || [])
        .sort((a: any, b: any) => a.display_order - b.display_order)
        .map((s: any) => ({
          label: s.label,
          cm: s.cm_description,
          price: s.price,
          mrp: s.mrp,
        })),
      colors: (data.product_colors || [])
        .sort((a: any, b: any) => a.display_order - b.display_order)
        .map((c: any) => ({
          name: c.name,
          hex: c.hex,
          border: c.has_border,
        })),
      details: (data.product_details || [])
        .sort((a: any, b: any) => a.display_order - b.display_order)
        .map((d: any) => ({
          label: d.label,
          value: d.value,
        })),
      includes: (data.product_includes || [])
        .sort((a: any, b: any) => a.display_order - b.display_order)
        .map((i: any) => i.item),
      reviews: mappedReviews,
      customerPhotos,
      verifiedCount: mappedReviews.filter((r: any) => r.verified).length,
      ratingBreakdown: [5, 4, 3, 2, 1].map((star) => ({
        stars: star,
        count: approved.filter((r: any) => Number(r.stars) === star).length,
      })),
      totalRatings: approved.length,
      /* An insight with no options would render an empty bar, so it is
         dropped here rather than guarded in three separate templates. */
      customerInsights: (data.customer_insights || [])
        .sort((a: any, b: any) => a.display_order - b.display_order)
        .map((ci: any) => ({
          label: ci.label,
          options: (ci.customer_insight_options || [])
            .sort((a: any, b: any) => a.display_order - b.display_order)
            .map((opt: any) => ({
              text: opt.text,
              pct: Number(opt.pct) || 0,
            })),
        }))
        .filter((ci: any) => ci.label && ci.options.length > 0),
      productCode: data.sku,
      related,
      images,
    };
  }
}

// Always available so the literal "product-not-found" route (and any slug
// that doesn't match a real product) renders a genuine not-found state
// instead of silently falling back to an arbitrary real product.
mappedProducts["product-not-found"] = {
  id: 0,
  slug: "product-not-found",
  name: "Product Not Found",
  brand: "Sunflora Studio",
  description: "This product could not be found or has no approved reviews.",
  price: 0,
  mrp: 0,
  images: [] as any[],
  sizes: [],
  colors: [],
  details: [],
  includes: [],
  rating: 0,
  reviewCount: 0,
  reviews: [],
  customerPhotos: [] as string[],
  verifiedCount: 0,
  ratingBreakdown: [] as any[],
  totalRatings: 0,
  customerInsights: [],
  productCode: "",
  related: [],
};

// Determine initial product for server-side HTML rendering
const product = mappedProducts[currentSlug] || mappedProducts["product-not-found"];

const images = product.images;
const discount =
  product.mrp > 0 ? Math.round((1 - product.price / product.mrp) * 100) : 0;
/* The inline hydration script below re-renders the parts of the page that
   were built before these routes were split per slug. The review section is
   not one of them — it is server-rendered from the same data and left alone,
   so the review rows (bodies, photo URLs, names) are dropped here instead of
   being shipped for every product on every product page. */
const productsJson = JSON.stringify(
  Object.fromEntries(
    Object.entries(mappedProducts).map(([key, value]: [string, any]) => {
      const {
        reviews: _reviews,
        customerPhotos: _customerPhotos,
        ratingBreakdown: _ratingBreakdown,
        customerInsights: _customerInsights,
        ...rest
      } = value;
      return [key, rest];
    }),
  ),
);

const site = "https://sunfloracrochet.in";
const productUrl = `${site}/productdetail/${product.slug}`;
const isRealProduct = product.slug !== "product-not-found" && images.length > 0;

/* Product/Offer — rendered from the same Supabase data fetched above at build
   time, so it's present in the initial HTML rather than injected by the
   client-side hydration script (Google processes JS-injected Product/Offer
   markup on a delayed pass). */
const productSchema = isRealProduct
  ? {
      "@context": "https://schema.org",
      "@type": "Product",
      "@id": `${productUrl}#product`,
      name: product.name,
      description: product.description,
      sku: product.sku,
      image: images.map((img: any) => toAbsoluteUrl(img.src)),
      brand: { "@type": "Brand", name: product.brand },
      offers: {
        "@type": "Offer",
        url: productUrl,
        priceCurrency: "INR",
        price: product.price,
        availability:
          product.inStock === false
            ? "https://schema.org/OutOfStock"
            : "https://schema.org/InStock",
      },
      ...(product.reviewCount > 0
        ? {
            aggregateRating: {
              "@type": "AggregateRating",
              ratingValue: product.rating,
              reviewCount: product.reviewCount,
              bestRating: 5,
              worstRating: 1,
            },
            /* Real, approved reviews — the newest few. Google wants the
               individual reviews an aggregateRating is claimed from, and
               marking up anything that is not shown on the page is what gets
               rich results revoked. */
            review: product.reviews
              .slice(0, 5)
              .map((r: any) => ({
                "@type": "Review",
                reviewRating: {
                  "@type": "Rating",
                  ratingValue: r.stars,
                  bestRating: 5,
                  worstRating: 1,
                },
                author: { "@type": "Person", name: r.author },
                ...(r.title ? { name: r.title } : {}),
                ...(r.body ? { reviewBody: r.body } : {}),
              })),
          }
        : {}),
    }
  : null;

const breadcrumbSchema = isRealProduct
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        {
          "@type": "ListItem",
          position: 2,
          name: "Shop",
          item: `${site}/productlist`,
        },
        { "@type": "ListItem", position: 3, name: product.name, item: productUrl },
      ],
    }
  : null;
---

<Layout
  title={`${product.name} — ${product.brand}`}
  description={product.description}
>
  {
    productSchema && (
      <Fragment slot="head">
        <script
          type="application/ld+json"
          set:html={JSON.stringify(productSchema)}
          is:inline
        />
        <script
          type="application/ld+json"
          set:html={JSON.stringify(breadcrumbSchema)}
          is:inline
        />
      </Fragment>
    )
  }
  <LandingNav />
  <div style="height: 72px; background-color: #fff8f0;"></div>
  <ProductBreadcrumb product={product} />

  <!-- MAIN PDP LAYOUT — white background -->
  <div class="pdp-wrapper">
    <div class="pdp-layout">
      <ProductGallery product={product} images={images} />
      <ProductInfo product={product} discount={discount} />
    </div>
  </div>

  <ProductReviews product={product} />
  <RelatedProducts product={product} />

  <!-- FOOTER -->
  <footer>
    <span
      >© {new Date().getFullYear()} Sunflora Studio — Handmade with care.</span
    >
    <span>Hooked in India · Shipped worldwide</span>
    <a href={contact.mailto}>{contact.email}</a>
  </footer>

  <div class="mobile-sticky" id="mobile-sticky">
    <div class="mobile-sticky-price">
      <div class="ms-name" id="sticky-name">{product.name}</div>
      <div class="ms-price" id="sticky-price">₹ {product.price}</div>
    </div>
    <a
      href={contact.whatsappUrl}
      class="mobile-sticky-btn"
      target="_blank"
      rel="noreferrer"
    >
      Order Now →
    </a>
  </div>

  <script is:inline define:vars={{ productsJson }}>
    const products = JSON.parse(productsJson);

    // 1. Get Product from URL Path
    const pathParts = window.location.pathname.split("/").filter(Boolean);
    const productSlug = pathParts[pathParts.length - 1] || "sunshine-amigurumi";
    const product = products[productSlug] || Object.values(products)[0];

    // 2. Hydration Function
    function hydratePDP(product) {
      // Page metadata & titles
      document.title = `${product.name} — ${product.brand}`;
      const metaDesc = document.querySelector('meta[name="description"]');
      if (metaDesc) metaDesc.setAttribute("content", product.description);

      const breadcrumbCurrent = document.querySelector(".breadcrumb-current");
      if (breadcrumbCurrent) breadcrumbCurrent.textContent = product.name;

      const breadcrumbParent = document.querySelector(
        ".breadcrumb a:nth-of-type(2)",
      );
      if (breadcrumbParent) {
        const cat =
          product.category ||
          (product.num === "01" ||
          product.num === "06" ||
          product.num === "07" ||
          product.num === "12"
            ? "Amigurumi"
            : product.num === "02" ||
                product.num === "04" ||
                product.num === "11"
              ? "Keychains"
              : product.num === "03" || product.num === "08"
                ? "Flower Stems"
                : product.num === "09"
                  ? "Bouquets"
                  : "Wall Hangings");
        breadcrumbParent.textContent = cat;
        breadcrumbParent.href =
          "/productlist?category=" + encodeURIComponent(cat);
      }

      const prodBrand = document.querySelector(".prod-brand");
      if (prodBrand) prodBrand.textContent = product.brand;
      const prodTitle = document.querySelector(".prod-title");
      if (prodTitle) prodTitle.textContent = product.name;

      const imgTag = document.getElementById("img-tag");
      if (imgTag) {
        if (product.tag) {
          imgTag.textContent = product.tag;
          imgTag.style.display = "";
        } else {
          imgTag.style.display = "none";
        }
      }

      // Ratings bar — the rating and its count are server-rendered from the
      // approved reviews for this slug, so only the SKU is touched here.
      const ratingSku = document.querySelector(".rating-sku");
      if (ratingSku) ratingSku.textContent = "SKU: " + product.sku;

      // Price block
      const activePrice = document.getElementById("active-price");
      const activeMrp = document.getElementById("active-mrp");
      const activeDisc = document.getElementById("active-disc");
      const stickyPrice = document.getElementById("sticky-price");
      const stickyName = document.getElementById("sticky-name");

      const discount =
        product.mrp > 0 ? Math.round((1 - product.price / product.mrp) * 100) : 0;
      if (activePrice) activePrice.textContent = "₹ " + product.price;
      if (activeMrp) activeMrp.textContent = "MRP ₹ " + product.mrp;
      if (activeDisc) activeDisc.textContent = "(" + discount + "% OFF)";
      if (stickyPrice) stickyPrice.textContent = "₹ " + product.price;
      if (stickyName) stickyName.textContent = product.name;

      // 3. Color swatches setup
      const colorLabel = document.getElementById("color-label");
      const colorContainer = document.getElementById("color-container");
      const colorSectionEl = document.querySelector(".color-section");

      if (product.colors && product.colors.length > 0) {
        if (colorSectionEl) colorSectionEl.style.display = "";
        if (colorLabel) colorLabel.textContent = "— " + product.colors[0].name;

        if (colorContainer) {
          colorContainer.innerHTML = product.colors
            .map(
              (c, i) => `
          <button
            class="color-swatch${i === 0 ? " active" : ""}${c.border ? " border-swatch" : ""}"
            style="background:${c.hex};"
            data-name="${c.name}"
            aria-label="${c.name}"
            title="${c.name}"
          ></button>
        `,
            )
            .join("");

          const swatches = colorContainer.querySelectorAll(".color-swatch");
          swatches.forEach((swatch) => {
            swatch.addEventListener("click", () => {
              swatches.forEach((s) => s.classList.remove("active"));
              swatch.classList.add("active");
              if (colorLabel)
                colorLabel.textContent = "— " + swatch.dataset.name;
            });
          });
        }
      } else {
        if (colorSectionEl) colorSectionEl.style.display = "none";
      }

      // 4. Size grid setup
      const sizesContainer = document.getElementById("sizes-container");
      if (sizesContainer) {
        sizesContainer.innerHTML = product.sizes
          .map(
            (s, i) => `
        <button
          class="size-btn${i === 0 ? " active" : ""}"
          data-price="${s.price}"
          data-mrp="${s.mrp || product.mrp + i * 200}"
          aria-pressed="${i === 0 ? "true" : "false"}"
        >
          <span class="sz-label">${s.label}</span>
          <span class="sz-cm">${s.cm}</span>
          <span class="sz-price">₹ ${s.price}</span>
        </button>
      `,
          )
          .join("");

        const sizeBtns = sizesContainer.querySelectorAll(".size-btn");
        sizeBtns.forEach((btn) => {
          btn.addEventListener("click", () => {
            sizeBtns.forEach((b) => {
              b.classList.remove("active");
              b.setAttribute("aria-pressed", "false");
            });
            btn.classList.add("active");
            btn.setAttribute("aria-pressed", "true");
            const p = parseInt(btn.dataset.price);
            const mrp = parseInt(btn.dataset.mrp);
            const disc = Math.round((1 - p / mrp) * 100);
            if (activePrice) activePrice.textContent = "₹ " + p;
            if (activeMrp) activeMrp.textContent = "MRP ₹ " + mrp;
            if (activeDisc) activeDisc.textContent = "(" + disc + "% OFF)";
            if (stickyPrice) stickyPrice.textContent = "₹ " + p;
          });
        });
      }

      // 5. Accordion Description & details table
      const prodDescPara = document.getElementById("product-description");
      if (prodDescPara) prodDescPara.textContent = product.description;

      const detailsTableBody = document.getElementById("details-table-body");
      if (detailsTableBody) {
        detailsTableBody.innerHTML = product.details
          .map(
            (d) => `
        <tr>
          <td>${d.label}</td>
          <td>${d.value}</td>
        </tr>
      `,
          )
          .join("");
      }

      const includesContainer = document.getElementById("includes-container");
      if (includesContainer) {
        includesContainer.innerHTML = product.includes
          .map(
            (item) => `
        <div class="includes-item">
          <svg class="includes-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          ${item}
        </div>
      `,
          )
          .join("");
      }

      /* The review section is server-rendered per slug from approved
         reviews and is not re-rendered here. It used to be rebuilt with
         innerHTML from this same blob, which both duplicated the markup
         and meant customer-written text was injected as HTML; its own
         behaviour (votes, read more, the form) now lives in
         ProductReviews.astro as a bundled module. */

      // 7. Related grid cards
      const relatedGridContainer = document.getElementById(
        "related-grid-container",
      );
      if (relatedGridContainer) {
        relatedGridContainer.innerHTML =
          product.related
            .map((o) => {
              const relDisc = Math.round((1 - o.price / o.mrp) * 100);
              return `
          <a href="/productdetail/${o.slug}" class="related-card">
            <div class="related-img-wrap">
              <img src="${o.img}" alt="${o.name}" />
              ${o.tag ? `<span class="related-badge">${o.tag}</span>` : ""}
            </div>
            <div class="related-body">
              <span class="related-brand">Sunflora Studio</span>
              <span class="related-name">${o.name}</span>
              <div class="related-price-row">
                <span class="related-price">₹ ${o.price}</span>
                <span class="related-mrp">₹ ${o.mrp}</span>
                <span class="related-disc">(${relDisc}% OFF)</span>
              </div>
            </div>
          </a>
        `;
            })
            .join("") +
          `
        <a href="/#offerings" class="related-card" style="align-items:center;justify-content:center;min-height:200px;border-style:dashed;background:transparent;color:var(--muted);">
          <div style="text-align:center;padding:1.5rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <p style="margin-top:0.5rem;font-size:0.75rem;letter-spacing:0.08em;text-transform:uppercase;">View All</p>
          </div>
        </a>
      `;
      }

      // 8. Gallery and thumb strip hydration
      const mainImg = document.getElementById("main-img");
      const thumbStrip = document.getElementById("thumb-strip");
      if (thumbStrip && mainImg) {
        mainImg.src = product.images[0]?.src || "";
        mainImg.alt = product.images[0]?.alt || product.name;
        if (product.images[0]?.srcset) mainImg.srcset = product.images[0].srcset;
        if (product.images[0]?.width) mainImg.width = product.images[0].width;
        if (product.images[0]?.height) mainImg.height = product.images[0].height;

        thumbStrip.innerHTML = product.images
          .map(
            (img, i) => `
        <button
          class="thumb-btn${i === 0 ? " active" : ""}"
          data-index="${i}"
          data-src="${img.src}"
          data-srcset="${img.srcset || ""}"
          data-width="${img.width || ""}"
          data-height="${img.height || ""}"
          aria-label="View image ${i + 1}"
        >
          <img
            src="${img.src}"
            srcset="${img.srcset || ""}"
            sizes="80px"
            width="${img.width || ""}"
            height="${img.height || ""}"
            alt="${img.alt || ""}"
            loading="lazy"
          />
        </button>
      `,
          )
          .join("");

        let current = 0;
        const thumbs = Array.from(thumbStrip.querySelectorAll(".thumb-btn"));

        function setImage(index) {
          if (index === current) return;
          mainImg.classList.add("fading");
          setTimeout(() => {
            const thumb = thumbs[index];
            mainImg.src = thumb.dataset.src;
            mainImg.srcset = thumb.dataset.srcset || "";
            if (thumb.dataset.width) mainImg.width = thumb.dataset.width;
            if (thumb.dataset.height) mainImg.height = thumb.dataset.height;
            mainImg.classList.remove("fading");
          }, 200);
          thumbs[current].classList.remove("active");
          thumbs[index].classList.add("active");
          current = index;
        }

        thumbs.forEach((btn, i) =>
          btn.addEventListener("click", () => setImage(i)),
        );

        const prevBtn = document.getElementById("img-prev");
        const nextBtn = document.getElementById("img-next");

        if (prevBtn) {
          const newPrev = prevBtn.cloneNode(true);
          prevBtn.parentNode.replaceChild(newPrev, prevBtn);
          newPrev.addEventListener("click", () =>
            setImage((current - 1 + thumbs.length) % thumbs.length),
          );
        }
        if (nextBtn) {
          const newNext = nextBtn.cloneNode(true);
          nextBtn.parentNode.replaceChild(newNext, nextBtn);
          newNext.addEventListener("click", () =>
            setImage((current + 1) % thumbs.length),
          );
        }
      }
    }

    // Hydrate UI with URL parameter product or default to Product 1
    hydratePDP(product);

    // 9. Standard Accordion logic (independent of specific product layout rebuild)
    const triggers = document.querySelectorAll(".accordion-trigger");
    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const expanded = trigger.getAttribute("aria-expanded") === "true";
        triggers.forEach((t) => {
          t.setAttribute("aria-expanded", "false");
          const body = document.getElementById(t.dataset.target);
          if (body) body.classList.remove("open");
        });
        if (!expanded) {
          trigger.setAttribute("aria-expanded", "true");
          const body = document.getElementById(trigger.dataset.target);
          if (body) body.classList.add("open");
        }
      });
    });

    // 10. Pincode check
    const pincodeInput = document.getElementById("pincode-input");
    const pincodeBtn = document.getElementById("pincode-btn");
    const deliveryNote = document.getElementById("delivery-note");
    if (pincodeBtn && pincodeInput) {
      pincodeBtn.addEventListener("click", () => {
        const val = pincodeInput.value.trim();
        if (val.length === 6 && /^\d+$/.test(val)) {
          deliveryNote.style.display = "flex";
        }
      });
      pincodeInput.addEventListener("keydown", (e) => {
        if (e.key === "Enter") pincodeBtn.click();
      });
    }

    // 11. Wishlist toggle
    const wishlistBtn = document.getElementById("wishlist-btn");
    if (wishlistBtn) {
      let wishlisted = false;
      wishlistBtn.addEventListener("click", () => {
        wishlisted = !wishlisted;
        wishlistBtn.style.color = wishlisted ? "var(--red)" : "";
        wishlistBtn.style.background = wishlisted ? "#fff0ef" : "";
        wishlistBtn.style.borderColor = wishlisted ? "var(--red)" : "";
        const icon = wishlistBtn.querySelector("svg");
        if (icon)
          icon.setAttribute("fill", wishlisted ? "currentColor" : "none");
      });
    }

    // 12. Insights Dialog
    const overlay = document.getElementById("insights-overlay");
    const viewDetailsBtn = document.getElementById("view-details-btn");
    const closeBtn = document.getElementById("insights-close");

    if (viewDetailsBtn && overlay && closeBtn) {
      viewDetailsBtn.addEventListener("click", () => {
        overlay.classList.add("open");
        document.body.style.overflow = "hidden";
      });
      closeBtn.addEventListener("click", () => {
        overlay.classList.remove("open");
        document.body.style.overflow = "";
      });
      overlay.addEventListener("click", (e) => {
        if (e.target === overlay) {
          overlay.classList.remove("open");
          document.body.style.overflow = "";
        }
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && overlay.classList.contains("open")) {
          overlay.classList.remove("open");
          document.body.style.overflow = "";
        }
      });
    }

    // 13. Mobile sticky: show when panel scrolls out
    const mobileSticky = document.getElementById("mobile-sticky");
    const productPanel = document.querySelector(".product-panel");
    if (mobileSticky && productPanel) {
      const obs = new IntersectionObserver(
        ([entry]) => {
          mobileSticky.style.transform = entry.isIntersecting
            ? "translateY(100%)"
            : "translateY(0)";
        },
        { threshold: 0 },
      );
      obs.observe(productPanel);
    }
    if (mobileSticky) {
      mobileSticky.style.transform = "translateY(100%)";
      mobileSticky.style.transition = "transform 0.3s";
    }
  </script>

  <script>
    import { addToCart } from "../../lib/cart.ts";

    function getSelected() {
      const panel = document.getElementById("product-panel");
      const productId = panel?.dataset.productId;
      const sku = panel?.dataset.productSku;
      const name = panel?.dataset.productName;
      const image = panel?.dataset.productImage;

      const activeSizeBtn = document.querySelector(
        "#sizes-container .size-btn.active",
      );
      const sizeLabel =
        activeSizeBtn?.querySelector(".sz-label")?.textContent?.trim() || null;
      const price = activeSizeBtn
        ? parseFloat(activeSizeBtn.dataset.price)
        : parseFloat(
            (
              document.getElementById("active-price")?.textContent || "0"
            ).replace(/[^\d.]/g, ""),
          );
      const mrp = activeSizeBtn
        ? parseFloat(activeSizeBtn.dataset.mrp)
        : parseFloat(
            (document.getElementById("active-mrp")?.textContent || "0").replace(
              /[^\d.]/g,
              "",
            ),
          );

      const activeColorBtn = document.querySelector(
        "#color-container .color-swatch.active",
      );
      const colorName = activeColorBtn?.dataset.name || null;

      const qtyInput = document.getElementById("qty-input");
      const quantity = Math.max(1, parseInt(qtyInput?.value || "1", 10) || 1);

      return {
        productId,
        sku,
        name,
        image,
        sizeLabel,
        price,
        mrp,
        colorName,
        quantity,
      };
    }

    function showFeedback(msg) {
      const el = document.getElementById("cart-feedback");
      if (!el) return;
      el.textContent = msg;
      el.style.display = "block";
      setTimeout(() => {
        el.style.display = "none";
      }, 2200);
    }

    document.getElementById("qty-minus")?.addEventListener("click", () => {
      const input = document.getElementById("qty-input");
      if (input)
        input.value = String(Math.max(1, parseInt(input.value || "1", 10) - 1));
    });
    document.getElementById("qty-plus")?.addEventListener("click", () => {
      const input = document.getElementById("qty-input");
      if (input)
        input.value = String(
          Math.min(20, parseInt(input.value || "1", 10) + 1),
        );
    });

    function addSelectedToCart() {
      const sel = getSelected();
      if (!sel.productId) return null;
      addToCart({
        product_id: sel.productId,
        name: sel.name,
        sku: sel.sku,
        size_label: sel.sizeLabel,
        color_name: sel.colorName,
        unit_price: sel.price,
        unit_mrp: sel.mrp,
        image_url: sel.image,
        quantity: sel.quantity,
      });
      return sel;
    }

    document
      .getElementById("add-to-cart-btn")
      ?.addEventListener("click", () => {
        if (addSelectedToCart()) showFeedback("Added to cart!");
      });

    document.getElementById("buy-now-btn")?.addEventListener("click", () => {
      if (addSelectedToCart()) window.location.href = "/checkout";
    });
  </script>
</Layout>
