---
import Layout from "../layouts/Layout.astro";
import LandingNav from "../components/landing/LandingNav.astro";
import LandingFooter from "../components/landing/LandingFooter.astro";

// Import generated clean-name assets
import BUNNY from "../assets/crochet_bunny.png";
import TULIPS from "../assets/crochet_tulip_bouquet.png";
import TOTE from "../assets/crochet_tote_bag.png";
import BEANIE from "../assets/crochet_beanie.png";
import BEAR from "../assets/crochet_teddy_bear.png";
import KEYCHAIN from "../assets/crochet_daisy_keychain.png";
import BASKET from "../assets/crochet_basket.png";
import CLIPS from "../assets/crochet_hair_clips.png";

import { getImageUrl } from "../lib/images";
import { createClient } from "@supabase/supabase-js";
import ProductListCategoryBar from "../components/ProductListCategoryBar.astro";
import ProductListControls from "../components/ProductListControls.astro";
import ProductListGrid from "../components/ProductListGrid.astro";
import ProductListRecommendations from "../components/ProductListRecommendations.astro";
import ProductListServiceBar from "../components/ProductListServiceBar.astro";
import "../styles/productlist.css";

const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_KEY,
);

function getFallbackImg(name: string, categoryName: string | null): string {
    const n = (name || "").toLowerCase();
    const cat = (categoryName || "").toLowerCase();

    // Map by exact name keywords first
    if (n.includes("bunny")) return BUNNY.src;
    if (n.includes("tulip") || n.includes("bouquet") || n.includes("flower"))
        return TULIPS.src;
    if (n.includes("bag") || n.includes("tote")) return TOTE.src;
    if (n.includes("beanie") || n.includes("cap") || n.includes("hat"))
        return BEANIE.src;
    if (n.includes("bear") || n.includes("teddy")) return BEAR.src;
    if (n.includes("keychain") || n.includes("daisy")) return KEYCHAIN.src;
    if (n.includes("basket") || n.includes("pot")) return BASKET.src;
    if (n.includes("clip") || n.includes("hair")) return CLIPS.src;

    // Map by category keywords
    if (
        cat.includes("soft") ||
        cat.includes("toy") ||
        cat.includes("amigurumi")
    )
        return BUNNY.src;
    if (cat.includes("flower") || cat.includes("bouquet")) return TULIPS.src;
    if (cat.includes("bag")) return TOTE.src;
    if (cat.includes("wearable")) return BEANIE.src;
    if (
        cat.includes("keychain") ||
        cat.includes("accessory") ||
        cat.includes("accessories")
    )
        return KEYCHAIN.src;
    if (cat.includes("decor") || cat.includes("basket") || cat.includes("home"))
        return BASKET.src;

    return BUNNY.src;
}

const { data: products } = await supabase
    .from("products_with_image") // the convenience view
    .select(
        `
    id, name, category_name, base_price, base_mrp,
    avg_rating, review_count, tag, is_new, in_stock,
    primary_image_path
  `,
    )
    .eq("is_active", true)
    // Deterministic shop order: owner-set display_order first (nulls last),
    // then name as a stable tiebreaker so the build output never reshuffles.
    .order("display_order", { ascending: true, nullsFirst: false })
    .order("name", { ascending: true });

// ── All products ──────────────────────────────────────────
const allProducts =
    products?.map((p) => {
        const rating = parseFloat(String(p.avg_rating)) || 0;
        const reviewCount = p.review_count || 0;

        return {
            id: p.id,
            name: p.name,
            category: p.category_name,
            price: p.base_price,
            mrp: p.base_mrp,
            rating,
            reviews: reviewCount,
            tag: p.tag,
            img: p.primary_image_path
                ? getImageUrl(p.primary_image_path, "product-images")
                : getFallbackImg(p.name, p.category_name),
            isNew: p.is_new,
            inStock: p.in_stock,
        };
    }) || [];

// ── Recommendation products (shown after 8 main products) ──
const { data: recoData } = await supabase
    .from("products_with_image")
    .select(
        "id, name, category_name, base_price, base_mrp, avg_rating, review_count, tag, primary_image_path",
    )
    .eq("is_active", true)
    .order("avg_rating", { ascending: false })
    // Stable tiebreaker only — primary sort stays "best rated first".
    .order("name", { ascending: true })
    .limit(4);

const recommendations = (recoData || []).map((p) => {
    const rating = parseFloat(String(p.avg_rating)) || 0;
    return {
        id: p.id,
        name: p.name,
        category: p.category_name,
        price: p.base_price,
        mrp: p.base_mrp,
        rating,
        reviews: p.review_count || 0,
        tag: p.tag,
        img: p.primary_image_path
            ? getImageUrl(p.primary_image_path, "product-images")
            : getFallbackImg(p.name, p.category_name),
    };
});

const { data: dbCategories } = await supabase
    .from("categories")
    .select("name, display_label")
    .eq("is_active", true)
    .order("display_order", { ascending: true, nullsFirst: false })
    .order("name", { ascending: true });

// Extract unique categories directly from products as a reliable fallback
const uniqueCategories = [
    ...new Set(products?.map((p) => p.category_name).filter(Boolean)),
];

/* A pill carries two different strings and they must not be confused: `name`
   is the identity the filter and the ?category= link compare on, `label` is
   only what a customer reads. They used to be related by a hardcoded map kept
   in two files, which meant the home page's cards and this bar could disagree
   about what the same category is called. The label now travels with the row. */
const categories: { name: string; label: string }[] = [
    { name: "All", label: "All Products" },
    ...(dbCategories && dbCategories.length > 0
        ? dbCategories.map((c) => ({ name: c.name, label: c.display_label || c.name }))
        : uniqueCategories.length > 0
          ? uniqueCategories.map((c) => ({ name: c as string, label: c as string }))
          : [
                "Amigurumi",
                "Keychains",
                "Flower Stems",
                "Wall Hangings",
                "Bouquets",
                "Customs",
            ].map((c) => ({ name: c, label: c }))),
];
---

<Layout
    title="Shop — Sunflora Handmade Crochet"
    description="Browse our full collection of handmade crochet pieces — amigurumi, keychains, florals and custom orders."
>
    <!-- ── NAV ── -->
    <LandingNav />

    <!-- ── STICKY CATEGORY BAR ── -->
    <ProductListCategoryBar categories={categories} />

    <!-- ── CONTROLS ROW ── -->
    <ProductListControls productCount={allProducts.length} />

    <!-- ── PRODUCT GRID ── -->
    <ProductListGrid products={allProducts} />

    <!-- ── LOAD MORE ── -->
    <div class="load-more-wrap" id="load-more-wrap" style="display:none;">
        <button class="load-more-btn" id="load-more-btn">
            Load more pieces
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path>
            </svg>
        </button>
    </div>

    <!-- ── RECOMMENDATIONS ── -->
    <ProductListRecommendations recommendations={recommendations} />

    <!-- ── SERVICE TRUST BAR ── -->
    <ProductListServiceBar />

    <!-- ── FOOTER ── -->
    <LandingFooter />

    <script is:inline>
        // ── Category filter ──────────────────────────────────────────
        const catBtns = document.querySelectorAll(".cat-pill-btn");
        const grid = document.getElementById("product-grid");
        const cards = Array.from(grid.querySelectorAll(".prod-card"));
        const countEl = document.getElementById("result-count");
        const emptyEl = document.getElementById("empty-state");
        const sortSel = document.getElementById("sort-select");

        let activeCategory = "All";

        // The pill already holds the label the database gave it, so read it
        // from there rather than keeping a second copy of the mapping here.
        function getCatDisplayLabel(cat) {
            const btn = Array.from(catBtns).find(
                (b) => b.dataset.cat.toLowerCase() === String(cat).toLowerCase(),
            );
            return btn ? btn.textContent.trim() : cat;
        }

        // Parse query parameter to pre-filter
        const urlParams = new URLSearchParams(window.location.search);
        const categoryParam = urlParams.get("category") || urlParams.get("cat");
        if (categoryParam) {
            const decodedCat = decodeURIComponent(categoryParam);
            const matchedBtn = Array.from(catBtns).find(
                (btn) =>
                    btn.dataset.cat.toLowerCase() === decodedCat.toLowerCase(),
            );
            if (matchedBtn) {
                catBtns.forEach((b) => {
                    b.classList.remove("active");
                    b.setAttribute("aria-selected", "false");
                });
                matchedBtn.classList.add("active");
                matchedBtn.setAttribute("aria-selected", "true");
                activeCategory = matchedBtn.dataset.cat;

                // Scroll the category button into view on mobile
                matchedBtn.scrollIntoView({
                    behavior: "auto",
                    block: "nearest",
                    inline: "center",
                    behavior: "smooth",
                });
            }
        }

        function filterAndSort() {
            const sort = sortSel.value;

            // Determine filtered set
            let filtered = cards.filter((c) => {
                if (activeCategory === "All") return true;
                return c.dataset.category === activeCategory;
            });

            // Sort
            filtered = [...filtered].sort((a, b) => {
                if (sort === "price-asc")
                    return Number(a.dataset.price) - Number(b.dataset.price);
                if (sort === "price-desc")
                    return Number(b.dataset.price) - Number(a.dataset.price);
                if (sort === "rating")
                    return Number(b.dataset.rating) - Number(a.dataset.rating);
                if (sort === "new")
                    return Number(b.dataset.new) - Number(a.dataset.new);
                return 0; // default = DOM order
            });

            // Hide all first
            cards.forEach((c) => {
                c.style.display = "none";
                c.style.animationName = "none";
            });

            // Re-show filtered and trigger animation
            filtered.forEach((c, i) => {
                grid.appendChild(c); // Physically reorder in DOM
                c.style.display = "";
                // Restart animation with staggered delay
                requestAnimationFrame(() => {
                    c.style.animationName = "";
                    c.style.animationDelay = i * 0.06 + "s";
                    c.style.animationDuration = "0.45s";
                    c.style.opacity = "0";
                    c.style.animationName = "cardIn";
                });
            });

            // Update count
            if (countEl) countEl.textContent = filtered.length;

            // Update heading title dynamically
            const headingTitleEl = document.getElementById(
                "category-heading-title",
            );
            if (headingTitleEl) {
                headingTitleEl.textContent = getCatDisplayLabel(activeCategory);
            }

            // Empty state
            if (emptyEl)
                emptyEl.classList.toggle("show", filtered.length === 0);
        }

        catBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                catBtns.forEach((b) => {
                    b.classList.remove("active");
                    b.setAttribute("aria-selected", "false");
                });
                btn.classList.add("active");
                btn.setAttribute("aria-selected", "true");
                activeCategory = btn.dataset.cat;

                // Scroll active btn into view on mobile
                btn.scrollIntoView({
                    behavior: "smooth",
                    block: "nearest",
                    inline: "center",
                });

                filterAndSort();
            });
        });

        sortSel.addEventListener("change", filterAndSort);

        // Run initial filter on page load
        filterAndSort();

        // ── Wishlist persistence (session) ───────────────────────────
        document.querySelectorAll(".card-wishlist").forEach((btn) => {
            btn.addEventListener("click", (e) => {
                e.preventDefault();
                e.stopPropagation();
                btn.classList.toggle("active");
                const svgPath = btn.querySelector("path");
                if (svgPath) {
                    const isActive = btn.classList.contains("active");
                    svgPath.setAttribute(
                        "fill",
                        isActive ? "currentColor" : "none",
                    );
                }
            });
        });

        // ── Recommendation section reveal on scroll ──────────────────
        const recoSection = document.getElementById("reco-section");
        if (recoSection) {
            const recoCards = recoSection.querySelectorAll(".prod-card");
            recoCards.forEach((c) => {
                c.style.opacity = "0";
                c.style.animationName = "none";
            });

            const recoObserver = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            recoCards.forEach((c, i) => {
                                c.style.animationDelay = i * 0.1 + "s";
                                c.style.animationDuration = "0.55s";
                                c.style.animationName = "cardIn";
                            });
                            recoObserver.disconnect();
                        }
                    });
                },
                { threshold: 0.1 },
            );
            recoObserver.observe(recoSection);
        }
    </script>
</Layout>
