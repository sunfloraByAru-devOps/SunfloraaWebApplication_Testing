<script define:vars={{ topicsData: topics }}>
    const ICONS_MAP = {
        sparkle: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v4M12 17v4M5 5l2.8 2.8M16.2 16.2L19 19M3 12h4M17 12h4M5 19l2.8-2.8M16.2 7.8L19 5"/><circle cx="12" cy="12" r="2.4"/></svg>`,
        handshake: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 12l2.5 2.5a1.8 1.8 0 0 0 2.5 0l.3-.3a1.8 1.8 0 0 0 0-2.5L11 9.4"/><path d="M2 11l4-4 4.3 4.3a1.6 1.6 0 0 1 0 2.3l-.2.2a1.6 1.6 0 0 1-2.3 0"/><path d="M22 11l-4-4-5.5 5.5"/><path d="M14 15l1.5 1.5a1.6 1.6 0 0 0 2.3 0l3.2-3.2"/></svg>`,
        compass: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polygon points="14.5 9.5 12.8 12.8 9.5 14.5 11.2 11.2 14.5 9.5"/></svg>`,
        box: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/></svg>`,
        bulb: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.6 10.8c.6.5 1.1 1.4 1.1 2.2h5c0-.8.5-1.7 1.1-2.2A6 6 0 0 0 12 3z"/></svg>`,
        "heart-alert": `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 8.6c0 5.6-8.8 10.9-8.8 10.9S3.2 14.2 3.2 8.6a4.8 4.8 0 0 1 8.8-2.7 4.8 4.8 0 0 1 8.8 2.7z"/><line x1="12" y1="7" x2="12" y2="11"/><circle cx="12" cy="13.6" r="0.6" fill="currentColor"/></svg>`,
    };

    const fieldSets = {
        custom: [
            {
                id: "idea",
                label: "What would you like us to create?",
                type: "textarea",
                full: true,
                placeholder:
                    "Describe your dream creation — character, colours, size...",
            },
            {
                id: "reference",
                label: "Reference / Inspiration Link (Optional)",
                type: "url",
                placeholder: "Pinterest, Instagram, or image link",
            },
            {
                id: "budget",
                label: "Budget Range",
                type: "select",
                options: [
                    "Under ₹500",
                    "₹500 – ₹1000",
                    "₹1000 – ₹2500",
                    "₹2500+",
                    "Not sure yet",
                ],
            },
            {
                id: "timeline",
                label: "Needed By (if any)",
                type: "text",
                placeholder: "e.g. Within 2 weeks / No rush",
            },
        ],
        partner: [
            {
                id: "business",
                label: "Business / Brand Name",
                type: "text",
                placeholder: "Your brand or company name",
            },
            {
                id: "website",
                label: "Website / Social Media (Optional)",
                type: "url",
                placeholder: "Link to your website or Instagram",
            },
            {
                id: "collab",
                label: "How would you like to collaborate?",
                type: "textarea",
                full: true,
                placeholder: "Tell us about your idea or proposal",
            },
            {
                id: "quantity",
                label: "Expected Order Quantity (if applicable)",
                type: "text",
                placeholder: "e.g. 50 pieces per month",
            },
            {
                id: "contactMethod",
                label: "Preferred Contact Method",
                type: "select",
                options: ["Email", "WhatsApp", "Phone Call", "Instagram DM"],
            },
        ],
        journey: [
            {
                id: "role",
                label: "What role interests you?",
                type: "select",
                options: [
                    "Collaborator",
                    "Intern",
                    "Local Reseller",
                    "Something else",
                ],
            },
            {
                id: "about",
                label: "Tell us about yourself",
                type: "textarea",
                full: true,
                placeholder:
                    "Your experience, skills, or what excites you about Sunflora",
            },
            {
                id: "portfolio",
                label: "Portfolio / Instagram Link (Optional)",
                type: "url",
                placeholder: "Link to your work or profile",
            },
        ],
        support: [
            {
                id: "orderNumber",
                label: "Order Number",
                type: "text",
                placeholder: "e.g. SF-10234",
            },
            {
                id: "issueType",
                label: "What do you need help with?",
                type: "select",
                options: [
                    "Order Status / Delay",
                    "Change to my Order",
                    "Shipping Address Update",
                    "Damaged / Wrong Item",
                    "Other",
                ],
            },
        ],
        feedback: [
            {
                id: "feedbackType",
                label: "What's on your mind?",
                type: "select",
                options: [
                    "Product Feedback",
                    "Website Feedback",
                    "An Idea or Suggestion",
                    "Just a Compliment ♡",
                ],
            },
        ],
        wrong: [
            {
                id: "orderNumber",
                label: "Order Number (if applicable)",
                type: "text",
                placeholder: "e.g. SF-10234",
            },
            {
                id: "wrongType",
                label: "What went wrong?",
                type: "select",
                options: [
                    "Payment Issue",
                    "Shipping Problem",
                    "Product Issue",
                    "Website Bug",
                    "Other",
                ],
            },
        ],
    };

    const topicsById = Object.fromEntries(topicsData.map((t) => [t.id, t]));

    const grid = document.getElementById("topic-grid");
    const noteCard = document.getElementById("note-card");
    const noteIcon = document.getElementById("note-icon");
    const noteTitle = document.getElementById("note-title");
    const noteDesc = document.getElementById("note-desc");
    const subjectIcon = document.getElementById("subject-icon");
    const subjectText = document.getElementById("subject-text");
    const dynamicFields = document.getElementById("dynamic-fields");

    function renderFieldsInto(container, topicId) {
        container.innerHTML = "";
        const fields = fieldSets[topicId] || [];
        let row = null;

        fields.forEach((f, i) => {
            const wrapClass = f.full ? "field field-full" : "field";
            const el = document.createElement("label");
            el.className = wrapClass;

            const labelEl = document.createElement("span");
            labelEl.className = "field-label";
            labelEl.textContent = f.label;
            el.appendChild(labelEl);

            let input;
            if (f.type === "textarea") {
                input = document.createElement("textarea");
                input.rows = 3;
                input.placeholder = f.placeholder || "";
            } else if (f.type === "select") {
                input = document.createElement("select");
                const blank = document.createElement("option");
                blank.value = "";
                blank.textContent = "Please select...";
                blank.disabled = true;
                blank.selected = true;
                input.appendChild(blank);
                (f.options || []).forEach((opt) => {
                    const o = document.createElement("option");
                    o.value = opt;
                    o.textContent = opt;
                    input.appendChild(o);
                });
            } else {
                input = document.createElement("input");
                input.type = f.type || "text";
                input.placeholder = f.placeholder || "";
            }
            input.name = f.id;
            input.id = `f-${f.id}`;
            el.appendChild(input);

            if (f.full) {
                container.appendChild(el);
                row = null;
            } else {
                if (!row) {
                    row = document.createElement("div");
                    row.className = "field-row";
                    container.appendChild(row);
                }
                row.appendChild(el);
                if (row.children.length >= 2) row = null;
            }
        });
    }

    function selectTopic(id) {
        const topic = topicsById[id];
        if (!topic) return;

        grid.querySelectorAll(".topic-card").forEach((card) => {
            const active = card.dataset.topic === id;
            card.classList.toggle("active", active);
            card.setAttribute("aria-pressed", active ? "true" : "false");
        });

        noteIcon.innerHTML = ICONS_MAP[topic.icon] || "";
        noteTitle.textContent = topic.noteTitle;
        noteDesc.textContent = topic.noteDesc;
        subjectIcon.innerHTML = ICONS_MAP[topic.icon] || "";
        subjectText.textContent = topic.subject;

        renderFieldsInto(dynamicFields, id);
    }

    grid.querySelectorAll(".topic-card").forEach((card) => {
        card.addEventListener("click", () => selectTopic(card.dataset.topic));
    });

    // Initial state: "Partner With Us" pre-selected, matching the reference design
    selectTopic("partner");

    // ── Form submission ──
    const form = document.getElementById("contact-form");
    const submitBtn = document.getElementById("submit-btn");
    const submitLabel = document.getElementById("submit-label");
    const successMsg = document.getElementById("form-success");

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const activeCard = grid.querySelector(".topic-card.active");
        const topicId = activeCard ? activeCard.dataset.topic : "partner";
        const topic = topicsById[topicId];

        const payload = {
            topic: topicId,
            subject: topic.subject,
            name: document.getElementById("f-name").value,
            email: document.getElementById("f-email").value,
            message: document.getElementById("f-message").value,
            details: Object.fromEntries(new FormData(form).entries()),
        };

        submitBtn.disabled = true;
        submitLabel.textContent = "Sending...";

        try {
            // Wire this up to your backend of choice (Supabase, a form API, etc.)
            // Example, matching this project's existing Supabase pattern:
            //
            // const { createClient } = await import("@supabase/supabase-js");
            // const supabase = createClient(import.meta.env.SUPABASE_URL, import.meta.env.SUPABASE_KEY);
            // await supabase.from("contact_messages").insert(payload);

            await new Promise((res) => setTimeout(res, 500)); // simulated latency

            form.reset();
            renderFieldsInto(dynamicFields, topicId);
            successMsg.hidden = false;
            submitLabel.textContent = "Send Message";
        } catch (err) {
            console.error("Contact form submission failed:", err);
            submitLabel.textContent = "Send Message";
            alert(
                "Something went wrong sending your message — please try again.",
            );
        } finally {
            submitBtn.disabled = false;
        }
    });

    // ══════════════════════════════════════════════
    // MOBILE STEP-FLOW (screens < 768px)
    // ══════════════════════════════════════════════
    const mobileFlow = document.getElementById("mobile-flow");
    if (mobileFlow) {
        const screens = mobileFlow.querySelectorAll(".mobile-screen");
        const backBtn = document.getElementById("mobile-back-btn");
        const topicListEl = document.getElementById("mobile-topic-list");
        const mDynamicFields = document.getElementById("mobile-dynamic-fields");
        const mFormTitle = document.getElementById("mobile-form-title");
        const mFormDesc = document.getElementById("mobile-form-desc");
        const mSubjectIcon = document.getElementById("mobile-subject-icon");
        const mSubjectText = document.getElementById("mobile-subject-text");
        const mForm = document.getElementById("mobile-contact-form");
        const mSubmitBtn = document.getElementById("mobile-submit-btn");
        const mSubmitLabel = document.getElementById("mobile-submit-label");
        const hamburgerBtn = document.getElementById("mobile-hamburger-btn");
        const drawer = document.getElementById("mobile-drawer");

        let mobileTopicId = "partner";

        function showScreen(n) {
            screens.forEach((s) =>
                s.classList.toggle("active", s.dataset.screen === String(n)),
            );
            backBtn.hidden = n !== 2;
            mobileFlow.scrollTo({ top: 0, behavior: "instant" });
            window.scrollTo({ top: 0, behavior: "instant" });
        }

        function loadMobileTopic(id) {
            const topic = topicsById[id];
            if (!topic) return;
            mobileTopicId = id;
            mFormTitle.innerHTML = `${topic.noteTitle} <span class="heart-icon">♡</span>`;
            mFormDesc.textContent = topic.noteDesc;
            mSubjectIcon.innerHTML = ICONS_MAP[topic.icon] || "";
            mSubjectText.textContent = topic.subject;
            renderFieldsInto(mDynamicFields, id);
        }

        topicListEl.querySelectorAll(".mobile-topic-row").forEach((row) => {
            row.addEventListener("click", () => {
                loadMobileTopic(row.dataset.topic);
                showScreen(2);
            });
        });

        backBtn.addEventListener("click", () => showScreen(1));

        mForm.addEventListener("submit", async (e) => {
            e.preventDefault();
            mSubmitBtn.disabled = true;
            mSubmitLabel.textContent = "Sending...";

            const payload = {
                topic: mobileTopicId,
                subject: topicsById[mobileTopicId]?.subject,
                details: Object.fromEntries(new FormData(mForm).entries()),
            };

            try {
                // Same backend hook as the desktop form — see comment above.
                await new Promise((res) => setTimeout(res, 500));
                mForm.reset();
                showScreen(3);
            } catch (err) {
                console.error("Contact form submission failed:", err);
                alert(
                    "Something went wrong sending your message — please try again.",
                );
            } finally {
                mSubmitBtn.disabled = false;
                mSubmitLabel.textContent = "Send Message";
            }
        });

        hamburgerBtn.addEventListener("click", () =>
            drawer.classList.toggle("open"),
        );
        drawer
            .querySelectorAll("a")
            .forEach((a) =>
                a.addEventListener("click", () =>
                    drawer.classList.remove("open"),
                ),
            );

        loadMobileTopic("partner");
    }

    // ── Fade-up on scroll (matches the rest of the site) ──
    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((el) => {
                if (el.isIntersecting) {
                    el.target.classList.add("in-view");
                    observer.unobserve(el.target);
                }
            });
        },
        { threshold: 0.08, rootMargin: "-60px 0px" },
    );
    document
        .querySelectorAll(".kn-fade-up")
        .forEach((el) => observer.observe(el));
</script>

