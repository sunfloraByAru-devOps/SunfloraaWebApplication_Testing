---
import Layout from "../layouts/Layout.astro";
import LandingNav from "../components/landing/LandingNav.astro";
import LandingFooter from "../components/landing/LandingFooter.astro";

/* ── Topic definitions: each drives the card, the note panel, the
     auto-filled subject, and which extra fields appear in the form ── */
const topics = [
    {
        id: "custom",
        title: "Custom Order",
        cardDesc: "I have an idea I'd love to bring to life.",
        subject: "Custom Order Inquiry",
        noteTitle: "Custom Order",
        noteDesc:
            "Have an idea you're dying to bring to life? A photo, a memory, a doodle — tell us everything and we'll make it real.",
        icon: "sparkle",
    },
    {
        id: "partner",
        title: "Partner With Us",
        cardDesc: "Let's collaborate and create something amazing.",
        subject: "Partnership Inquiry",
        noteTitle: "Partner With Us",
        noteDesc:
            "We love collaborating with brands, boutiques, creators and businesses who value handmade goodness. Let's build something beautiful together.",
        icon: "handshake",
    },
    {
        id: "journey",
        title: "Join Our Journey",
        cardDesc: "I want to work or create with you.",
        subject: "Join Our Journey",
        noteTitle: "Join Our Journey",
        noteDesc:
            "Whether you'd like to collaborate, intern, or just be part of our little world — we'd love to hear from you.",
        icon: "compass",
    },
    {
        id: "support",
        title: "Order Support",
        cardDesc: "I need help with my existing order.",
        subject: "Order Support",
        noteTitle: "Order Support",
        noteDesc:
            "Need help with an order that's already on its way to you? We've got you covered — just tell us the details.",
        icon: "box",
    },
    {
        id: "feedback",
        title: "Feedback & Ideas",
        cardDesc: "I have an idea or feedback to share.",
        subject: "Feedback & Ideas",
        noteTitle: "Feedback & Ideas",
        noteDesc:
            "Your thoughts help us grow. Good, bad, or somewhere in between — we're genuinely listening.",
        icon: "bulb",
    },
    {
        id: "wrong",
        title: "Something Went Wrong",
        cardDesc: "I'm facing an issue and need help.",
        subject: "Something Went Wrong",
        noteTitle: "Something Went Wrong",
        noteDesc:
            "We're sorry to hear that. Tell us what happened and we'll do everything we can to make it right.",
        icon: "heart-alert",
    },
];

/* Server-rendered icon markup — mirrors ICONS_MAP in the client script below,
   so cards render correctly before JS hydrates. */
const ICONS: Record<string, string> = {
    sparkle: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v4M12 17v4M5 5l2.8 2.8M16.2 16.2L19 19M3 12h4M17 12h4M5 19l2.8-2.8M16.2 7.8L19 5"/><circle cx="12" cy="12" r="2.4"/></svg>`,
    handshake: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 12l2.5 2.5a1.8 1.8 0 0 0 2.5 0l.3-.3a1.8 1.8 0 0 0 0-2.5L11 9.4"/><path d="M2 11l4-4 4.3 4.3a1.6 1.6 0 0 1 0 2.3l-.2.2a1.6 1.6 0 0 1-2.3 0"/><path d="M22 11l-4-4-5.5 5.5"/><path d="M14 15l1.5 1.5a1.6 1.6 0 0 0 2.3 0l3.2-3.2"/></svg>`,
    compass: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polygon points="14.5 9.5 12.8 12.8 9.5 14.5 11.2 11.2 14.5 9.5"/></svg>`,
    box: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/></svg>`,
    bulb: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.6 10.8c.6.5 1.1 1.4 1.1 2.2h5c0-.8.5-1.7 1.1-2.2A6 6 0 0 0 12 3z"/></svg>`,
    "heart-alert": `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 8.6c0 5.6-8.8 10.9-8.8 10.9S3.2 14.2 3.2 8.6a4.8 4.8 0 0 1 8.8-2.7 4.8 4.8 0 0 1 8.8 2.7z"/><line x1="12" y1="7" x2="12" y2="11"/><circle cx="12" cy="13.6" r="0.6" fill="currentColor"/></svg>`,
};
---

<Layout
    title="Contact Us — Sunflora | Handmade Crochet"
    description="We'd love to hear from you. Whatever brings you here, choose a topic and let's connect — custom orders, partnerships, feedback, or support."
>
    <div class="desktop-chrome">
        <LandingNav />
    </div>

    <main class="contact-page desktop-flow">
        <!-- ── HERO ── -->
        <section class="contact-hero kn-fade-up">
            <div class="kn-container contact-hero-inner">
                <div class="contact-hero-text">
                    <span class="contact-eyebrow">Let's Connect ♡</span>
                    <h1 class="contact-heading">
                        We'd love to<br />
                        hear from you <span class="heart-icon">♡</span>
                    </h1>
                    <p class="contact-sub">
                        Whatever brings you here, we're happy you found us.
                        Choose a topic and we'll take it from there.
                    </p>
                </div>

                <div class="contact-hero-visual" aria-hidden="true">
                    <span class="hero-visual-label"
                        >What brings you here today?</span
                    >
                    <img
                        src="/images/landing/yarn-ball.png"
                        alt=""
                        class="deco deco-yarn"
                        loading="lazy"
                    />
                    <img
                        src="/images/landing/prod-teddy.png"
                        alt=""
                        class="deco deco-teddy"
                        loading="lazy"
                    />
                    <div class="deco deco-tag">
                        <p>Handmade with love,<br />just for you.</p>
                        <span class="heart-icon">♡</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── TOPIC SELECTOR ── -->
        <section class="topic-section kn-fade-up">
            <div class="kn-container">
                <div class="topic-grid" id="topic-grid">
                    {
                        topics.map((t, i) => (
                            <button
                                type="button"
                                class={`topic-card ${i === 1 ? "active" : ""}`}
                                data-topic={t.id}
                                aria-pressed={i === 1 ? "true" : "false"}
                            >
                                <span class="topic-check" aria-hidden="true">
                                    <svg
                                        width="12"
                                        height="12"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="3"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <polyline points="20 6 9 17 4 12" />
                                    </svg>
                                </span>
                                <span
                                    class="topic-icon"
                                    set:html={ICONS[t.icon]}
                                />
                                <span class="topic-title">{t.title}</span>
                                <span class="topic-desc">{t.cardDesc}</span>
                            </button>
                        ))
                    }
                </div>
                <p class="topic-hint">
                    Tell us more so we can help better <span class="heart-icon"
                        >♡</span>
                </p>
            </div>
        </section>

        <!-- ── FORM SECTION ── -->
        <section class="form-section kn-fade-up">
            <div class="kn-container">
                <div class="form-grid">
                    <!-- Left: sticky note -->
                    <div class="note-wrap">
                        <div class="note-card" id="note-card">
                            <span class="note-tape" aria-hidden="true"></span>
                            <span
                                class="note-icon"
                                id="note-icon"
                                set:html={ICONS.handshake}
                            />
                            <h3 class="note-title" id="note-title">
                                Partner With Us
                            </h3>
                            <p class="note-desc" id="note-desc">
                                We love collaborating with brands, boutiques,
                                creators and businesses who value handmade
                                goodness.
                                <br /><br />
                                Let's build something beautiful together.
                            </p>
                            <span class="heart-icon note-heart">♡</span>
                        </div>
                        <img
                            src="/images/landing/yarn-strand.png"
                            alt=""
                            class="note-yarn-deco"
                            aria-hidden="true"
                            loading="lazy"
                        />
                    </div>

                    <!-- Right: form -->
                    <form class="contact-form" id="contact-form">
                        <label class="field field-subject">
                            <span class="field-label">Subject (automatic)</span>
                            <span class="subject-display" id="subject-display">
                                <span
                                    id="subject-icon"
                                    set:html={ICONS.handshake}
                                />
                                <span id="subject-text"
                                    >Partnership Inquiry</span
                                >
                                <svg
                                    width="14"
                                    height="14"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="lock-icon"
                                    ><rect
                                        x="3"
                                        y="11"
                                        width="18"
                                        height="11"
                                        rx="2"></rect><path
                                        d="M7 11V7a5 5 0 0 1 10 0v4"
                                    ></path></svg
                                >
                            </span>
                        </label>

                        <div class="field-row">
                            <label class="field">
                                <span class="field-label">Your Name</span>
                                <input
                                    type="text"
                                    name="name"
                                    id="f-name"
                                    placeholder="Enter your full name"
                                    required
                                />
                            </label>
                            <label class="field">
                                <span class="field-label">Email Address</span>
                                <input
                                    type="email"
                                    name="email"
                                    id="f-email"
                                    placeholder="Enter your email"
                                    required
                                />
                            </label>
                        </div>

                        <!-- Dynamic topic-specific fields render here -->
                        <div id="dynamic-fields"></div>

                        <label class="field field-full">
                            <span class="field-label">Additional Message</span>
                            <textarea
                                name="message"
                                id="f-message"
                                rows="4"
                                placeholder="Anything else you'd like to share with us..."
                            ></textarea>
                        </label>

                        <div class="form-footer">
                            <p class="form-note">
                                <span class="heart-icon">♡</span> We read every message
                                and value every connection.
                            </p>
                            <button
                                type="submit"
                                class="kn-btn-primary"
                                id="submit-btn"
                            >
                                <span id="submit-label">Send Message</span>
                                <svg
                                    width="16"
                                    height="16"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <line x1="22" y1="2" x2="11" y2="13"></line>
                                    <polygon points="22 2 15 22 11 13 2 9 22 2"
                                    ></polygon>
                                </svg>
                            </button>
                        </div>

                        <p class="form-success" id="form-success" hidden>
                            Your message has been received and means a lot to
                            us. We'll be in touch soon <span class="heart-icon"
                                >♡</span
                            >
                        </p>
                    </form>
                </div>
            </div>
        </section>

        <!-- ── WHAT HAPPENS NEXT STRIP ── -->
        <section class="next-strip kn-fade-up">
            <div class="kn-container next-strip-inner">
                <div class="polaroid-wrap">
                    <div class="polaroid">
                        <img
                            src="/images/landing/prod-yarn.png"
                            alt="Basket of hand-dyed yarn"
                            loading="lazy"
                        />
                    </div>
                    <div class="sticky-note">
                        <p class="sticky-title">Thank you!</p>
                        <p class="sticky-body">
                            Your message has been received and means a lot to
                            us.
                        </p>
                        <span class="heart-icon">♡</span>
                    </div>
                </div>

                <div class="envelope-deco" aria-hidden="true">
                    <svg width="70" height="70" viewBox="0 0 70 70" fill="none">
                        <rect
                            x="8"
                            y="20"
                            width="54"
                            height="38"
                            rx="4"
                            stroke="#C8862C"
                            stroke-width="1.5"></rect>
                        <path
                            d="M8 22L35 44L62 22"
                            stroke="#C8862C"
                            stroke-width="1.5"
                            fill="none"></path>
                    </svg>
                </div>

                <div class="next-text">
                    <p class="next-title">
                        We'll get back to you within 1-2 business days.
                    </p>
                    <p class="next-body">
                        Until then, feel free to explore our creations and stay
                        connected with us. <span class="heart-icon">♡</span>
                    </p>
                </div>
            </div>
        </section>

        <p class="made-with-love">
            <span aria-hidden="true">✦</span> Made with love, just for you <span
                class="heart-icon">♡</span
            >
            <span aria-hidden="true">✦</span>
        </p>
    </main>

    <!-- ══════════════════════════════════════════════
       MOBILE STEP-FLOW (screens < 768px)
       Screen 1: browse topics · Screen 2: form · Screen 3: thank you
  ══════════════════════════════════════════════ -->
    <div class="mobile-flow" id="mobile-flow">
        <!-- App bar -->
        <header class="mobile-appbar">
            <button
                type="button"
                class="mobile-back-btn"
                id="mobile-back-btn"
                hidden
            >
                <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><polyline points="15 18 9 12 15 6"></polyline></svg
                >
                Back
            </button>
            <a href="/" class="mobile-logo"
                >Knotique<span class="heart-icon">♡</span></a
            >
            <button
                type="button"
                class="mobile-hamburger"
                id="mobile-hamburger-btn"
                aria-label="Menu"
            >
                <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><line x1="3" y1="6" x2="21" y2="6"></line><line
                        x1="3"
                        y1="12"
                        x2="21"
                        y2="12"></line><line x1="3" y1="18" x2="21" y2="18"
                    ></line></svg
                >
            </button>
        </header>

        <!-- Slide-out drawer -->
        <div class="mobile-drawer" id="mobile-drawer">
            <a href="/">Home</a>
            <a href="/productlist">Shop</a>
            <a href="/custom">Custom Orders</a>
            <a href="/#about">About Us</a>
            <a href="/#story">Our Story</a>
            <a href="/contact" class="active">Contact</a>
        </div>

        <!-- ── SCREEN 1: Browse topics ── -->
        <section class="mobile-screen active" data-screen="1">
            <div class="mobile-hero-photo">
                <img
                    src="/images/landing/prod-teddy.png"
                    alt=""
                    loading="lazy"
                />
                <img
                    src="/images/landing/yarn-ball.png"
                    alt=""
                    class="mobile-hero-yarn"
                    loading="lazy"
                />
                <div class="mobile-hero-tag">
                    <p>Handmade<br />with love,<br />just for you.</p>
                    <span class="heart-icon">♡</span>
                </div>
            </div>

            <div class="mobile-content">
                <span class="contact-eyebrow">Let's Connect ♡</span>
                <h1 class="contact-heading">
                    We'd love to<br />hear from you <span class="heart-icon"
                        >♡</span
                    >
                </h1>
                <p class="contact-sub">
                    Whatever brings you here, we're happy you found us. Choose a
                    topic and we'll take it from there.
                </p>

                <p class="mobile-hint">What brings you here today?</p>

                <div class="mobile-topic-list" id="mobile-topic-list">
                    {
                        topics.map((t) => (
                            <button
                                type="button"
                                class="mobile-topic-row"
                                data-topic={t.id}
                            >
                                <span
                                    class="mtr-icon"
                                    set:html={ICONS[t.icon]}
                                />
                                <span class="mtr-text">
                                    <span class="mtr-title">{t.title}</span>
                                    <span class="mtr-desc">{t.cardDesc}</span>
                                </span>
                                <svg
                                    width="18"
                                    height="18"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="mtr-chevron"
                                >
                                    <polyline points="9 18 15 12 9 6" />
                                </svg>
                            </button>
                        ))
                    }
                </div>

                <p class="mobile-footnote">
                    <span class="heart-icon">♡</span> We read every message and value
                    every connection.
                </p>
            </div>
        </section>

        <!-- ── SCREEN 2: Form ── -->
        <section class="mobile-screen" data-screen="2">
            <div class="mobile-hero-photo mobile-form-photo">
                <img
                    src="/images/landing/prod-bag.png"
                    alt=""
                    id="mobile-form-photo-img"
                    loading="lazy"
                />
                <img
                    src="/images/landing/prod-tulips.png"
                    alt=""
                    class="mobile-hero-flower"
                    loading="lazy"
                />
            </div>

            <div class="mobile-content">
                <h2 class="mobile-form-title" id="mobile-form-title">
                    Partner With Us <span class="heart-icon">♡</span>
                </h2>
                <p class="mobile-form-desc" id="mobile-form-desc">
                    We love collaborating with brands, boutiques, creators and
                    businesses who value handmade goodness. Let's build
                    something beautiful together.
                </p>

                <form class="mobile-contact-form" id="mobile-contact-form">
                    <label class="field field-subject">
                        <span class="field-label">Subject (automatic)</span>
                        <span class="subject-display">
                            <span
                                id="mobile-subject-icon"
                                set:html={ICONS.handshake}
                            />
                            <span id="mobile-subject-text"
                                >Partnership Inquiry</span
                            >
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="lock-icon"
                                ><rect
                                    x="3"
                                    y="11"
                                    width="18"
                                    height="11"
                                    rx="2"></rect><path
                                    d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
                            >
                        </span>
                    </label>

                    <label class="field">
                        <span class="field-label">Your Name</span>
                        <input
                            type="text"
                            name="name"
                            id="mf-name"
                            placeholder="Enter your full name"
                            required
                        />
                    </label>

                    <label class="field">
                        <span class="field-label">Email Address</span>
                        <input
                            type="email"
                            name="email"
                            id="mf-email"
                            placeholder="Enter your email"
                            required
                        />
                    </label>

                    <!-- Dynamic topic-specific fields render here -->
                    <div id="mobile-dynamic-fields"></div>

                    <label class="field field-full">
                        <span class="field-label">Additional Message</span>
                        <textarea
                            name="message"
                            id="mf-message"
                            rows="4"
                            placeholder="Anything else you'd like to share..."
                        ></textarea>
                    </label>

                    <p class="form-note mobile-form-note">
                        <span class="heart-icon">♡</span> We read every message and
                        value every connection.
                    </p>

                    <button
                        type="submit"
                        class="kn-btn-primary mobile-submit-btn"
                        id="mobile-submit-btn"
                    >
                        <span id="mobile-submit-label">Send Message</span>
                        <svg
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><line x1="22" y1="2" x2="11" y2="13"
                            ></line><polygon points="22 2 15 22 11 13 2 9 22 2"
                            ></polygon></svg
                        >
                    </button>
                </form>
            </div>
        </section>

        <!-- ── SCREEN 3: Thank you ── -->
        <section class="mobile-screen" data-screen="3">
            <div class="mobile-content thankyou-content">
                <div class="thankyou-icon-wrap">
                    <span class="thankyou-heart-mini thankyou-heart-1">♡</span>
                    <span class="thankyou-heart-mini thankyou-heart-2">♡</span>
                    <svg
                        width="46"
                        height="46"
                        viewBox="0 0 24 24"
                        fill="var(--kn-rose)"
                        stroke="none"
                        ><path
                            d="M12 21s-7.5-4.9-10-9.6C.5 7.8 2.4 4 6 4c2 0 3.6 1.1 4.5 2.7C11.4 5.1 13 4 15 4c3.6 0 5.5 3.8 4 7.4C19.5 16.1 12 21 12 21z"
                        ></path></svg
                    >
                </div>

                <h1 class="thankyou-title">
                    Thank you! <span class="heart-icon">♡</span>
                </h1>
                <p class="thankyou-sub">
                    Your message has been received and means a lot to us.
                </p>
                <p class="thankyou-sub">
                    We'll get back to you within 1–2 business days.
                </p>

                <div class="thankyou-basket-wrap">
                    <img
                        src="/images/landing/prod-yarn.png"
                        alt="Basket of hand-dyed yarn"
                        loading="lazy"
                    />
                    <div class="basket-tag">
                        <p>Made<br />with love.</p>
                        <span class="heart-icon">♡</span>
                    </div>
                </div>

                <div class="next-steps-card">
                    <p class="next-steps-heading">What happens next?</p>
                    <div class="timeline">
                        <div class="timeline-item">
                            <span class="timeline-icon">
                                <svg
                                    width="18"
                                    height="18"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    ><rect
                                        x="2"
                                        y="5"
                                        width="20"
                                        height="14"
                                        rx="2"></rect><path d="M2 7l10 6 10-6"
                                    ></path></svg
                                >
                            </span>
                            <span>
                                <span class="timeline-title"
                                    >We've received your message</span
                                >
                                <span class="timeline-desc"
                                    >You'll get a confirmation email shortly.</span
                                >
                            </span>
                        </div>
                        <div class="timeline-item">
                            <span class="timeline-icon">
                                <svg
                                    width="18"
                                    height="18"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    ><circle cx="12" cy="12" r="9"
                                    ></circle><path d="M8 12l2.5 2.5L16 9"
                                    ></path></svg
                                >
                            </span>
                            <span>
                                <span class="timeline-title"
                                    >Our team will review it</span
