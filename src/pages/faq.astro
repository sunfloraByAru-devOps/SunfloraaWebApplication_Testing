---
import Layout from "../layouts/Layout.astro";
import LandingNav from "../components/landing/LandingNav.astro";
import LandingFooter from "../components/landing/LandingFooter.astro";
import LandingFaq from "../components/landing/LandingFaq.astro";
import { faqGroups } from "../data/faqs";

/* FAQPage structured data — lets Google surface these answers directly. */
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqGroups.flatMap((group) =>
    group.items.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  ),
};
---

<Layout
  title="FAQ — Sunflora | Handmade Crochet"
  description="Shipping, custom orders, returns and care — everything people ask us about our handmade crochet pieces, answered honestly."
>
  <LandingNav />

  <main>
    <div class="pt-[90px] md:pt-[100px]">
      <!-- Page hero -->
      <section class="faq-hero">
        <div class="kn-container">
          <span class="faq-hero-eyebrow">The asked things</span>
          <h1 class="faq-hero-title">Curious? <em>Same.</em></h1>
          <p class="faq-hero-sub">
            Everything people write to us about — how long things take, what
            they're made of, and what happens if something isn't right. If your
            question isn't here, just <a href="/contact">ask us</a>.
          </p>

          <nav class="faq-jump" aria-label="Jump to a topic">
            {
              faqGroups.map((group) => (
                <a href={`#${group.id}`} class="faq-jump-link">
                  {group.title}
                </a>
              ))
            }
          </nav>
        </div>
      </section>

      <LandingFaq variant="full" showHeader={false} />

      <!-- Closing CTA -->
      <section class="faq-cta">
        <div class="kn-container">
          <div class="faq-cta-card kn-fade-up">
            <h2 class="faq-cta-title">Still have a question?</h2>
            <p class="faq-cta-text">
              We read every message — and we'd much rather you ask than wonder.
            </p>
            <a href="/contact" class="kn-btn-primary">
              Talk to us
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <LandingFooter />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
    is:inline
  />
</Layout>

<style>
  .faq-hero {
    background: var(--kn-cream-alt);
    padding: 72px 0 64px;
    text-align: center;
  }

  .faq-hero-eyebrow {
    display: block;
    font-family: var(--kn-font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--kn-rose);
    margin-bottom: 16px;
  }

  .faq-hero-title {
    font-family: var(--kn-font-heading);
    font-size: clamp(32px, 4.4vw, 52px);
    font-weight: 700;
    color: var(--kn-brown);
    line-height: 1.15;
    margin-bottom: 18px;
  }

  .faq-hero-title em {
    font-style: normal;
    color: var(--kn-rose);
  }

  .faq-hero-sub {
    font-family: var(--kn-font-body);
    font-size: 15px;
    line-height: 1.75;
    color: var(--kn-brown-light);
    max-width: 520px;
    margin: 0 auto;
  }

  .faq-hero-sub a {
    color: var(--kn-rose);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .faq-jump {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 32px;
  }

  .faq-jump-link {
    font-family: var(--kn-font-body);
    font-size: 12px;
    font-weight: 600;
    color: var(--kn-brown);
    background: var(--kn-white);
    border: 1px solid var(--kn-taupe);
    padding: 9px 18px;
    border-radius: var(--kn-radius-full);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .faq-jump-link:hover {
    color: var(--kn-white);
    background: var(--kn-rose);
    border-color: var(--kn-rose);
  }

  .faq-cta {
    background: var(--kn-white);
    padding: 0 0 var(--kn-section-py);
  }

  .faq-cta-card {
    background: var(--kn-cream-alt);
    border-radius: var(--kn-radius-xl);
    padding: 56px 40px;
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
  }

  .faq-cta-title {
    font-family: var(--kn-font-heading);
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 700;
    color: var(--kn-brown);
    margin-bottom: 12px;
  }

  .faq-cta-text {
    font-family: var(--kn-font-body);
    font-size: 15px;
    line-height: 1.7;
    color: var(--kn-brown-light);
    margin-bottom: 28px;
  }

  @media (max-width: 640px) {
    .faq-hero {
      padding: 48px 0 44px;
    }

    .faq-cta-card {
      padding: 40px 24px;
    }
  }
</style>

<script>
  // Lenis smooth scroll — mirrors index.astro
  (async () => {
    const Lenis = (await import("lenis")).default;
    const lenis = new Lenis({
      duration: 1.2,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    });
    const loop = (time: number) => {
      lenis.raf(time);
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);

    // Lenis hijacks scrolling, so native #anchor jumps need routing through it
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
      link.addEventListener("click", (e) => {
        const target = document.querySelector(link.getAttribute("href") ?? "");
        if (!target) return;
        e.preventDefault();
        lenis.scrollTo(target as HTMLElement, { offset: -100 });
      });
    });
  })();

  // Intersection Observer for fade-up animations
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((el) => {
        if (el.isIntersecting) {
          el.target.classList.add("in-view");
          observer.unobserve(el.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: "-60px 0px" },
  );

  document
    .querySelectorAll(".kn-fade-up")
    .forEach((el) => observer.observe(el));
</script>
