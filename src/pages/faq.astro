---
import Layout from "../layouts/Layout.astro";
import LandingNav from "../components/landing/LandingNav.astro";
import LandingFooter from "../components/landing/LandingFooter.astro";
import LandingFaq from "../components/landing/LandingFaq.astro";
import { faqGroups } from "../data/faqs";

const site = "https://sunfloracrochet.in";

/* FAQPage — lets Google surface these answers directly in search results. */
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${site}/faq#faq`,
  inLanguage: "en-IN",
  mainEntity: faqGroups.flatMap((group) =>
    group.items.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  ),
};

/* Breadcrumbs — gives the result a readable path instead of a bare URL. */
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
    { "@type": "ListItem", position: 2, name: "FAQ", item: `${site}/faq` },
  ],
};

/* Who is answering. Ties the FAQ to the business for entity search. */
const businessSchema = {
  "@context": "https://schema.org",
  "@type": "Store",
  "@id": `${site}/#store`,
  name: "Sunflora",
  description:
    "Handmade crochet studio in India — amigurumi soft toys, crochet flower bouquets, home decor and custom orders, made to order and shipped free across India.",
  url: site,
  email: "sunflorabyaru@gmail.com",
  founder: { "@type": "Person", name: "Aru Jaiswal" },
  areaServed: { "@type": "Country", name: "India" },
  currenciesAccepted: "INR",
  paymentAccepted: "UPI, Credit Card, Debit Card, Net Banking",
  sameAs: ["https://www.instagram.com/sunfloraa.a/"],
};

const totalQuestions = faqGroups.reduce((n, g) => n + g.items.length, 0);
---

<Layout
  title="FAQ — Sunflora | Handmade Crochet Soft Toys & Flower Bouquets"
  description="Shipping, custom orders, returns, care and safety — everything people ask about our handmade crochet bouquets and amigurumi. Free shipping across India, made to order in 7–10 days."
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
      is:inline
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
      is:inline
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(businessSchema)}
      is:inline
    />
  </Fragment>

  <LandingNav />

  <main>
    <div class="pt-[90px] md:pt-[100px]">
      <!-- Page hero -->
      <section class="faq-hero">
        <div class="kn-container">
          <nav class="faq-crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">FAQ</span>
          </nav>

          <span class="faq-hero-eyebrow">The asked things</span>
          <h1 class="faq-hero-title">Curious? <em>Same.</em></h1>
          <p class="faq-hero-sub">
            {totalQuestions} honest answers about our handmade crochet — how long
            a piece takes to make, what it's made of, whether it's safe for a
            baby, and what happens if something isn't right. If your question
            isn't here, just <a href="/contact">ask us</a>.
          </p>

          <!-- Short, scannable facts. These are what people actually search for,
               and what a featured snippet is most likely to lift. -->
          <ul class="faq-facts">
            <li><strong>Free shipping</strong><span>every order, all India</span></li>
            <li><strong>7–10 days</strong><span>made to order</span></li>
            <li><strong>7-day returns</strong><span>on ready-made pieces</span></li>
            <li><strong>Cotton yarn</strong><span>baby-safe on request</span></li>
          </ul>

          <nav class="faq-jump" aria-label="Jump to a topic">
            {
              faqGroups.map((group) => (
                <a href={`#${group.id}`} class="faq-jump-link">
                  {group.title}
                </a>
              ))
            }
          </nav>
        </div>
      </section>

      <LandingFaq variant="full" showHeader={false} />

      <!-- Closing CTA + internal links -->
      <section class="faq-cta">
        <div class="kn-container">
          <div class="faq-cta-card kn-fade-up">
            <h2 class="faq-cta-title">Still have a question?</h2>
            <p class="faq-cta-text">
              We read every message — and we'd much rather you ask than wonder.
            </p>
            <a href="/contact" class="kn-btn-primary">
              Talk to us
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>

            <div class="faq-links">
              <a href="/productlist">Shop all crochet pieces</a>
              <a href="/custom">Start a custom order</a>
              <a href="/track-order">Track an order</a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <LandingFooter />
</Layout>

<style>
  .faq-hero {
    background: var(--kn-cream-alt);
    padding: 56px 0 64px;
    text-align: center;
  }

  .faq-crumbs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--kn-font-body);
    font-size: 12px;
    color: var(--kn-brown-muted);
    margin-bottom: 28px;
  }

  .faq-crumbs a {
    color: var(--kn-brown-muted);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .faq-crumbs a:hover {
    color: var(--kn-rose);
  }

  .faq-hero-eyebrow {
    display: block;
    font-family: var(--kn-font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--kn-rose);
    margin-bottom: 16px;
  }

  .faq-hero-title {
    font-family: var(--kn-font-heading);
    font-size: clamp(32px, 4.4vw, 52px);
    font-weight: 700;
    color: var(--kn-brown);
    line-height: 1.15;
    margin-bottom: 18px;
  }

  .faq-hero-title em {
    font-style: normal;
    color: var(--kn-rose);
  }

  .faq-hero-sub {
    font-family: var(--kn-font-body);
    font-size: 15px;
    line-height: 1.75;
    color: var(--kn-brown-light);
    max-width: 560px;
    margin: 0 auto;
  }

  .faq-hero-sub a {
    color: var(--kn-rose);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .faq-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    list-style: none;
    padding: 0;
    margin: 36px auto 0;
    max-width: 720px;
  }

  .faq-facts li {
    flex: 1 1 150px;
    background: var(--kn-white);
    border: 1px solid var(--kn-taupe-light);
    border-radius: var(--kn-radius-md);
    padding: 16px 14px;
  }

  .faq-facts strong {
    display: block;
    font-family: var(--kn-font-body);
    font-size: 14px;
    font-weight: 700;
    color: var(--kn-rose);
    margin-bottom: 3px;
  }

  .faq-facts span {
    font-family: var(--kn-font-body);
    font-size: 12px;
    line-height: 1.5;
    color: var(--kn-brown-muted);
  }

  .faq-jump {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 36px;
  }

  .faq-jump-link {
    font-family: var(--kn-font-body);
    font-size: 12px;
    font-weight: 600;
    color: var(--kn-brown);
    background: var(--kn-white);
    border: 1px solid var(--kn-taupe);
    padding: 9px 18px;
    border-radius: var(--kn-radius-full);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .faq-jump-link:hover {
    color: var(--kn-white);
    background: var(--kn-rose);
    border-color: var(--kn-rose);
  }

  .faq-cta {
    background: var(--kn-white);
    padding: 0 0 var(--kn-section-py);
  }

  .faq-cta-card {
    background: var(--kn-cream-alt);
    border-radius: var(--kn-radius-xl);
    padding: 56px 40px;
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
  }

  .faq-cta-title {
    font-family: var(--kn-font-heading);
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 700;
    color: var(--kn-brown);
    margin-bottom: 12px;
  }

  .faq-cta-text {
    font-family: var(--kn-font-body);
    font-size: 15px;
    line-height: 1.7;
    color: var(--kn-brown-light);
    margin-bottom: 28px;
  }

  .faq-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 24px;
    margin-top: 32px;
    padding-top: 26px;
    border-top: 1px solid var(--kn-taupe);
  }

  .faq-links a {
    font-family: var(--kn-font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--kn-brown-light);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .faq-links a:hover {
    color: var(--kn-rose);
  }

  @media (max-width: 640px) {
    .faq-hero {
      padding: 40px 0 44px;
    }

    .faq-facts {
      gap: 8px;
    }

    .faq-facts li {
      flex: 1 1 calc(50% - 8px);
      padding: 13px 10px;
    }

    .faq-cta-card {
      padding: 40px 24px;
    }
  }
</style>

<script>
  // Lenis smooth scroll — mirrors index.astro
  (async () => {
    const Lenis = (await import("lenis")).default;
    const lenis = new Lenis({
      duration: 1.2,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    });
    const loop = (time: number) => {
      lenis.raf(time);
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);

    // Lenis hijacks scrolling, so native #anchor jumps need routing through it
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
      link.addEventListener("click", (e) => {
        const target = document.querySelector(link.getAttribute("href") ?? "");
        if (!target) return;
        e.preventDefault();
        lenis.scrollTo(target as HTMLElement, { offset: -100 });
      });
    });
  })();

  // Intersection Observer for fade-up animations
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((el) => {
        if (el.isIntersecting) {
          el.target.classList.add("in-view");
          observer.unobserve(el.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: "-60px 0px" },
  );

  document
    .querySelectorAll(".kn-fade-up")
    .forEach((el) => observer.observe(el));
</script>
