---
import Layout from "./Layout.astro";
import LandingNav from "../components/landing/LandingNav.astro";
import LandingFooter from "../components/landing/LandingFooter.astro";

interface Props {
  title: string;
  description: string;
  effectiveDate: string;
}

const { title, description, effectiveDate } = Astro.props;
---

<Layout title={title} description={description}>
  <LandingNav />

  <main class="legal-page">
    <div class="legal-container">
      <p class="legal-effective">Effective {effectiveDate}</p>
      <h1 class="legal-title"><slot name="title" /></h1>
      <div class="legal-body">
        <slot />
      </div>
    </div>
  </main>

  <LandingFooter />
</Layout>

<style>
  .legal-page {
    padding: 140px 0 var(--kn-section-py);
    background: var(--kn-cream);
  }

  .legal-container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .legal-effective {
    font-family: var(--kn-font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--kn-rose);
    margin-bottom: 14px;
  }

  .legal-title {
    font-family: var(--kn-font-heading);
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 700;
    color: var(--kn-brown);
    line-height: 1.15;
    margin-bottom: 40px;
  }

  .legal-body :global(h2) {
    font-family: var(--kn-font-heading);
    font-size: 21px;
    font-weight: 700;
    color: var(--kn-brown);
    margin: 40px 0 14px;
  }

  .legal-body :global(h2:first-child) {
    margin-top: 0;
  }

  .legal-body :global(h3) {
    font-family: var(--kn-font-body);
    font-size: 14.5px;
    font-weight: 700;
    color: var(--kn-brown);
    margin: 24px 0 8px;
  }

  .legal-body :global(p) {
    font-family: var(--kn-font-body);
    font-size: 14.5px;
    line-height: 1.8;
    color: var(--kn-brown-light);
    margin-bottom: 14px;
  }

  .legal-body :global(ul),
  .legal-body :global(ol) {
    font-family: var(--kn-font-body);
    font-size: 14.5px;
    line-height: 1.8;
    color: var(--kn-brown-light);
    margin: 0 0 14px;
    padding-left: 22px;
  }

  .legal-body :global(li) {
    margin-bottom: 6px;
  }

  .legal-body :global(li > strong) {
    color: var(--kn-brown);
  }

  .legal-body :global(a) {
    color: var(--kn-rose);
    text-decoration: underline;
  }

  .legal-body :global(strong) {
    color: var(--kn-brown);
    font-weight: 700;
  }

  .legal-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 4px 0 20px;
    font-family: var(--kn-font-body);
    font-size: 13px;
  }

  .legal-body :global(th),
  .legal-body :global(td) {
    text-align: left;
    padding: 10px 12px;
    border: 1px solid var(--kn-taupe-light);
    color: var(--kn-brown-light);
    vertical-align: top;
  }

  .legal-body :global(th) {
    background: var(--kn-cream-alt);
    color: var(--kn-brown);
    font-weight: 700;
  }

  .legal-body :global(hr) {
    border: none;
    border-top: 1px solid var(--kn-taupe-light);
    margin: 32px 0;
  }
</style>
