---
import "../styles/global.css";
import CookieConsent from "../components/CookieConsent.astro";
import { DEFAULT_OG_IMAGE } from "../lib/seo";
const {
  title = "My Website",
  description = "My awesome website",
  robots,
  image = DEFAULT_OG_IMAGE,
  imageAlt = "Sunflora — handmade crochet",
  ogType = "website",
} = Astro.props;

/* Canonical URL — without this, /faq and /faq/ can be indexed as duplicates. */
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

/* twitter:card is summary_large_image but there was no image tag anywhere,
   so every shared link rendered as a bare text card. `image` may be a
   site-relative path (most callers) or already-absolute (product photos via
   toAbsoluteUrl) — resolving through URL() handles both without a caller
   needing to know which. */
const ogImage = new URL(image, Astro.site ?? Astro.url).href;
---

<!DOCTYPE html>
<html lang="en-IN">
  <head>
    <!-- Basic SEO -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* global.css pulls the fonts in with @import, so the browser only learns
       it needs fonts.gstatic.com after that stylesheet has downloaded and
       parsed. Opening both connections up front overlaps the handshakes with
       that wait instead of queueing behind it. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Inter:wght@400;500;700&display=swap"
    />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Keeping a page out of the sitemap does not keep it out of the index —
       these routes are still linked from the nav, so Google can reach them
       either way. The meta tag is what actually stops indexing. */}
    {robots && <meta name="robots" content={robots} />}

    <!-- Browser UI theme color -->
    <meta name="theme-color" content="#FFF8F0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#5C3D2E" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FFF8F0" />

    <!-- Title -->
    <title>{title}</title>

    <!-- Open Graph (for social sharing) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Sunflora" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Per-page head extras (structured data, preloads) -->
    <slot name="head" />
  </head>

  <body class="paper-grain min-h-screen relative">
    <slot />
    <CookieConsent />
  </body>
</html>