---
import { productSlug } from "../lib/slug";

interface Product {
  id: number;
  name: string;
  category: string | null;
  price: number;
  mrp: number;
  rating: number;
  reviews: number;
  tag: string | null;
  img: string;
  isNew: boolean;
  inStock: boolean;
}
interface Props {
  products: Product[];
}
const { products } = Astro.props;
---
<section class="products-section" aria-label="Products">
    <div class="product-grid" id="product-grid">
        {
            products.map((p) => {
                return (
                    <a
                        href={`/productdetail/${productSlug(p.name)}`}
                        class={`prod-card${
                            !p.inStock ? " out-of-stock" : ""
                        }`}
                        data-category={p.category}
                        data-price={p.price}
                        data-rating={p.rating}
                        data-new={p.isNew ? "1" : "0"}
                        aria-label={`${p.name} — ₹${p.price}`}
                    >
                        <div class="card-img-wrap">
                            <img
                                src={p.img}
                                alt={p.name}
                                class="card-img"
                                loading="lazy"
                                width={300}
                                height={300}
                            />
                            {!p.inStock && (
                                <div class="out-of-stock-badge">
                                    <span>Sold Out</span>
                                </div>
                            )}
                            <button
                                class="card-wishlist"
                                aria-label={`Wishlist ${p.name}`}
                                onclick="event.preventDefault(); this.classList.toggle('active');"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="14"
                                    height="14"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                                </svg>
                            </button>
                            <span class="card-price-badge">₹{p.price}</span>
                        </div>
                    </a>
                );
            })
        }
    </div>

    <!-- Empty state -->
    <div class="empty-state" id="empty-state">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="48"
            height="48"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            ><path
                d="M3 3l1.88 5.76a1 1 0 0 0 .95.69h14.34a1 1 0 0 0 .95-.69L23 3"
            ></path><path d="M9 14v1a3 3 0 0 0 6 0v-1"></path><path
                d="M3 3H2"></path>
        </svg>
        <p>Nothing here yet — try another category.</p>
    </div>
</section>
