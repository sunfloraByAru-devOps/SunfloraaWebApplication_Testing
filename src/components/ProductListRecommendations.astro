---
import { productSlug } from "../lib/slug";

interface Recommendation {
  id: number;
  name: string;
  category: string | null;
  price: number;
  mrp: number;
  rating: number;
  reviews: number;
  tag: string | null;
  img: string;
}
interface Props {
  recommendations: Recommendation[];
}
const { recommendations } = Astro.props;
---
<div class="reco-section" id="reco-section">
    <div class="reco-divider">
        <div class="reco-divider-inner">
            <div>
                <p class="reco-eyebrow">Curated for you</p>
                <h2 class="reco-title">
                    Explore our <em>recommendations</em>
                </h2>
            </div>
            <a href="#" class="reco-arrow-link">
                See all
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M7 17L17 7"></path><path d="M7 7h10v10"
                    ></path>
                </svg>
            </a>
        </div>
        <div class="reco-grid">
            {
                recommendations.map((p) => {
                    return (
                        <a
                            href={`/productdetail/${productSlug(p.name)}`}
                            class="prod-card"
                            aria-label={`${p.name} — ₹${p.price}`}
                        >
                            <div class="card-img-wrap">
                                <img
                                    src={p.img}
                                    alt={p.name}
                                    class="card-img"
                                    loading="lazy"
                                />
                                <button
                                    class="card-wishlist"
                                    aria-label={`Wishlist ${p.name}`}
                                    onclick="event.preventDefault(); this.classList.toggle('active');"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="14"
                                        height="14"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.8"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                                    </svg>
                                </button>
                                <span class="card-price-badge">₹{p.price}</span>
                            </div>
                        </a>
                    );
                })
            }
        </div>
    </div>
</div>
