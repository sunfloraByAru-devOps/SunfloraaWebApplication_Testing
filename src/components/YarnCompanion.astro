---
// YarnCompanion: a tactile yarn ball that rolls down the page and comes to rest
// at whichever section is currently in view, trailing a real thread behind it.
// It does NOT scrub continuously with scroll — it hops, bounces, and settles,
// like something with actual weight.
const stops = [
  { sel: '#heroWrap',   top: '68vh', left: '4.5%',  rot: -8  },
  { sel: '#categories', top: '30vh', left: '3.5%',  rot: 14  },
  { sel: '#bestsellers',top: '42vh', left: '90%',   rot: -18 },
  { sel: '#custom',     top: '58vh', left: '4%',    rot: 10  },
  { sel: '#gallery',    top: '26vh', left: '89%',   rot: -12 },
  { sel: '[data-testid="site-footer"]', top: '70vh', left: '5%', rot: 16 },
];
---

<div class="yarn-companion" id="yarnCompanion" aria-hidden="true" style={`--stop-top:${stops[0].top}; --stop-left:${stops[0].left}; --stop-rot:${stops[0].rot}deg;`}>
  <div class="yarn-thread" id="yarnThread"></div>

  <div class="yarn-ball-outer" id="yarnBallOuter">
    <div class="yarn-ball-inner" id="yarnBallInner">
      <svg viewBox="0 0 120 120" width="100%" height="100%">
        <defs>
          <radialGradient id="yb-shade" cx="34%" cy="28%" r="78%">
            <stop offset="0%" stop-color="#F6E2B4"></stop>
            <stop offset="45%" stop-color="#E3A94E"></stop>
            <stop offset="78%" stop-color="#C8862C"></stop>
            <stop offset="100%" stop-color="#8A5A20"></stop>
          </radialGradient>
          <filter id="yb-fuzz" x="-30%" y="-30%" width="160%" height="160%">
            <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" result="noise"></feTurbulence>
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="6"></feDisplacementMap>
          </filter>
          <filter id="yb-shadow" x="-50%" y="-50%" width="220%" height="220%">
            <feDropShadow dx="0" dy="5" stdDeviation="6" flood-color="#1A1815" flood-opacity="0.35"></feDropShadow>
          </filter>
        </defs>

        <g filter="url(#yb-shadow)">
          <circle cx="60" cy="60" r="48" fill="url(#yb-shade)" filter="url(#yb-fuzz)"></circle>
        </g>

        <g fill="none" stroke="#7A5322" stroke-width="2.2" stroke-linecap="round" opacity="0.5" filter="url(#yb-fuzz)">
          <path d="M14 46 C 34 20, 86 20, 106 46"></path>
          <path d="M12 66 C 34 96, 86 96, 108 66"></path>
          <path d="M20 26 C 42 52, 42 78, 22 100"></path>
          <path d="M100 24 C 78 50, 78 76, 98 98"></path>
          <path d="M60 10 C 46 40, 46 80, 60 112"></path>
          <path d="M60 10 C 74 40, 74 80, 60 112"></path>
        </g>

        <ellipse cx="42" cy="36" rx="14" ry="8" fill="#FFF3D9" opacity="0.55"></ellipse>

        <!-- loose end feeding into the trailing thread -->
        <path d="M18 88 C 6 96, 0 104, -6 116" stroke="#C8862C" stroke-width="3" fill="none" stroke-linecap="round"></path>
      </svg>
    </div>
  </div>
</div>

<style>
  .yarn-companion {
    position: fixed;
    top: var(--stop-top);
    left: var(--stop-left);
    z-index: 45;
    pointer-events: none;
    transition: top 1000ms cubic-bezier(0.34, 1.35, 0.4, 1), left 1000ms cubic-bezier(0.34, 1.35, 0.4, 1);
    transform: translate(-50%, -50%);
  }

  .yarn-thread {
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: 3px;
    height: var(--thread-len, 0px);
    transform: translateX(-50%);
    background: linear-gradient(to bottom, rgba(220, 161, 69, 0) 0%, #C8862C 12%, #C8862C 100%);
    border-radius: 3px;
    transition: height 1000ms cubic-bezier(0.34, 1.35, 0.4, 1);
  }

  .yarn-ball-outer {
    width: clamp(56px, 6.2vw, 82px);
    height: clamp(56px, 6.2vw, 82px);
    transform: rotate(var(--stop-rot));
    transition: transform 1000ms cubic-bezier(0.34, 1.35, 0.4, 1);
  }

  .yarn-ball-inner {
    width: 100%;
    height: 100%;
    animation: yarnIdle 4.6s ease-in-out infinite;
    transform-origin: 50% 55%;
  }

  .yarn-companion.is-rolling .yarn-ball-inner {
    animation: yarnRoll 1000ms cubic-bezier(0.3, 0.7, 0.35, 1);
  }

  .yarn-companion.is-landing .yarn-ball-inner {
    animation: yarnLand 480ms ease-out;
  }

  @keyframes yarnIdle {
    0%, 100% { transform: rotate(-3deg) translateY(0); }
    50%      { transform: rotate(3deg) translateY(-3px); }
  }

  @keyframes yarnRoll {
    from { transform: rotate(-260deg); }
    to   { transform: rotate(0deg); }
  }

  @keyframes yarnLand {
    0%   { transform: scale(1, 1); }
    45%  { transform: scale(1.18, 0.78); }
    75%  { transform: scale(0.94, 1.08); }
    100% { transform: scale(1, 1); }
  }

  @media (max-width: 640px) {
    .yarn-companion { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .yarn-ball-inner,
    .yarn-companion.is-rolling .yarn-ball-inner,
    .yarn-companion.is-landing .yarn-ball-inner {
      animation: none !important;
    }
    .yarn-companion { transition: none !important; }
  }
</style>

<script define:vars={{ stops }}>
  function init() {
    const el = document.getElementById('yarnCompanion');
    const outer = document.getElementById('yarnBallOuter');
    if (!el || !outer) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const list = stops
      .map((s) => ({ ...s, node: document.querySelector(s.sel) }))
      .filter((s) => s.node);

    if (!list.length) return;

    let current = -1;

    function goTo(index) {
      if (index === current || index < 0) return;
      const s = list[index];
      current = index;

      el.style.setProperty('--stop-top', s.top);
      el.style.setProperty('--stop-left', s.left);
      el.style.setProperty('--stop-rot', s.rot + 'deg');

      // thread length = current top offset (in px), so it always reaches the top of the viewport
      const vh = window.innerHeight;
      const topPx = s.top.endsWith('vh') ? (parseFloat(s.top) / 100) * vh : parseFloat(s.top);
      el.style.setProperty('--thread-len', Math.max(0, topPx) + 'px');

      if (!reduceMotion) {
        el.classList.remove('is-landing');
        el.classList.add('is-rolling');
        window.setTimeout(() => {
          el.classList.remove('is-rolling');
          el.classList.add('is-landing');
          window.setTimeout(() => el.classList.remove('is-landing'), 520);
        }, 980);
      }

      // stitch any headings inside this section
      document.querySelectorAll('[data-stitch-target]').forEach((n) => n.classList.remove('stitched'));
      s.node.querySelectorAll('[data-stitch-target]').forEach((n) => {
        window.setTimeout(() => n.classList.add('stitched'), 350);
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const idx = list.findIndex((s) => s.node === entry.target);
            if (idx !== -1) goTo(idx);
          }
        });
      },
      { threshold: 0, rootMargin: '-42% 0px -42% 0px' }
    );

    list.forEach((s) => observer.observe(s.node));
    goTo(0);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>