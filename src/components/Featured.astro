---
import SUN_CLOSEUP from '../assets/Lily_bouquet_1.png';
import SUNFLOWER        from '../assets/Sunflower_Pot_1-removebg-preview.png';
import TURTLE           from '../assets/turtle-removebg-preview.png';
import SPIDEY           from '../assets/spiderman-removebg-preview.png';
import DINO             from '../assets/Lil_Dino_keychain_1-removebg-preview.png';

const categories = [
  { 
    slug:    "bouquet",
    name:    "Bouquet",
    count:   "12 pieces",
    bg:      "#F2C4A0",
    product: { id: 1, name: "Sunshine Bouquet",  price: "₹ 649", rating: "4.9", img: SUN_CLOSEUP },
  },
  {
    slug:    "single-flower",
    name:    "Single Flower",
    count:   "18 pieces",
    bg:      "#F4D4C8",
    product: { id: 3, name: "Sun & Moon Stem",   price: "₹ 449", rating: "4.8", img: SUNFLOWER },
  },
  {
    slug:    "plushie",
    name:    "Plushie",
    count:   "24 pieces",
    bg:      "#D6E8C8",
    product: { id: 5, name: "Turtle",  price: "₹ 549", rating: "4.9", img: TURTLE },
  },
  {
    slug:    "amigurumi",
    name:    "Amigurumi",
    count:   "24 pieces",
    bg:      "#FAE1A0",
    product: { id: 2, name: "Lil' Dino Friend",  price: "₹ 549", rating: "4.9", img: DINO },
  },
  {
    slug:    "keychain-bagcharm",
    name:    "Keychain / Bagcharm",
    count:   "18 pieces",
    bg:      "#E8D0F0",
    product: { id: 4, name: "Spidey Charm",       price: "₹ 249", rating: "4.7", img: SPIDEY },
  },
  {
    slug:    "hanging-charms",
    name:    "Hanging Charms",
    count:   "9 pieces",
    bg:      "#C8DFF2",
    product: null,
  },
];

const categoryMap: Record<string, string> = {
  "bouquet":           "Bouquets",
  "single-flower":     "Flower Stems",
  "plushie":           "Amigurumi",
  "amigurumi":         "Amigurumi",
  "keychain-bagcharm": "Keychains",
  "hanging-charms":    "Wall Hangings",
};

function toSlug(name: string) {
  return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
}
---

<section id="categories" data-testid="categories" class="py-24 md:py-32">
  <div class="max-w-[1400px] mx-auto px-6 md:px-12">

    <!-- ── Section Header ── -->
    <div class="mb-16 md:mb-20">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
        <h2 class="fade-up font-serif-display text-5xl md:text-6xl lg:text-7xl text-[#1A1815] leading-none tracking-tight">
          Our<br/>Specialities
        </h2>
        <p class="fade-up text-[14px] md:text-[16px] leading-[1.75] text-[#4A453E] max-w-[320px] md:text-right pb-1">
          Slow-crafted with warmth,<br/>made for the ones you love.
        </p>
      </div>
      <div class="mt-8 h-px bg-gradient-to-r from-[#C8862C]/40 via-[#C8862C]/15 to-transparent" />
    </div>


    <!-- ════════════════════════════════════════════
         MOBILE  –  Timeline list (hidden on md+)
         ════════════════════════════════════════════ -->
    <div class="md:hidden relative">

      <!-- Vertical timeline line -->
      <div
        aria-hidden="true"
        class="absolute left-[19px] top-3 bottom-3 w-px"
        style="background: linear-gradient(to bottom, transparent 0%, #C8862C66 6%, #C8862C66 94%, transparent 100%);"
      />

      <div class="flex flex-col gap-3.5">
        {categories.map((c) => (
          <div
            class="relative flex items-stretch gap-3 fade-up"
            data-testid={`category-${c.slug}`}
          >

            <!-- Timeline dot -->
            <div class="flex-shrink-0 flex flex-col items-center w-10 pt-[1.35rem] z-10">
              <div
                class="w-[13px] h-[13px] rounded-full border-[1.5px] border-[#C8862C] shadow-sm"
                style={`background-color: ${c.bg};`}
              />
            </div>

            <!-- Card -->
            <div
              class="flex-1 rounded-2xl overflow-hidden relative"
              style={`aspect-ratio: ${c.product?.img ? '3/4' : '4/3'};`}
            >

              <!-- Product image: contained so it floats on bg -->
              {c.product?.img ? (
                <a
                  href={`/productlist?category=${encodeURIComponent(categoryMap[c.slug] || 'All')}`}
                  aria-label={`Browse ${c.name}`}
                  class="absolute inset-0 z-0 flex items-center justify-center p-6 pb-16"
                >
                  <img
                    src={c.product.img.src}
                    alt={c.product.name}
                    class="w-full h-full object-contain drop-shadow-[0_8px_24px_rgba(0,0,0,0.12)] transition-transform duration-700 hover:scale-105"
                  />
                </a>
              ) : (
                <div class="absolute inset-0 z-0 flex flex-col items-center justify-center gap-2 opacity-35">
                  <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="rgba(26,24,21,0.5)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                  </svg>
                  <span class="text-[10px] uppercase tracking-[0.18em] text-[#4A453E]/60">Coming soon</span>
                </div>
              )}

              <!-- Subtle bottom fade (card's own bg colour, not black) -->
              <div
  class="absolute inset-0 pointer-events-none"
  style={`
    background:
      radial-gradient(
        ellipse 40% 18% at 50% 72%,
        rgba(55, 55, 55, 0.18) 0%,
        rgba(55, 55, 55, 0.10) 35%,
        rgba(55, 55, 55, 0.04) 60%,
        transparent 100%
      );
  `}
/>

              <!-- TOP: category name (left) + Buy now for price (right) -->
              <div class="absolute top-0 left-0 right-0 flex items-start justify-between p-3.5 z-20">
                <a
                  href={`/productlist?category=${encodeURIComponent(categoryMap[c.slug] || 'All')}`}
                  data-testid={`category-label-${c.slug}`}
                  class="font-serif-display text-[1.25rem] text-[#1A1815] leading-tight hover:opacity-70 transition-opacity"
                >
                  {c.name}
                </a>

                {c.product && (
                  <a
                    href={`/productdetail/${toSlug(c.product.name)}`}
                    data-testid={`product-buy-${c.product.id}`}
                    aria-label={`Buy ${c.product.name} for ${c.product.price}`}
                    class="flex-shrink-0 ml-2 bg-[#1A1815] hover:bg-[#C8862C] text-white text-[9px] uppercase tracking-[0.12em] px-3 py-1.5 rounded-full inline-flex items-center gap-1.5 transition-all duration-300 font-medium whitespace-nowrap shadow-sm"
                  >
                    Buy now for {c.product.price}
                  </a>
                )}
              </div>

              <!-- BOTTOM: rating (left) + explore all (centre) + notify -->
              <div class="absolute bottom-0 left-0 right-0 p-3.5 z-20">

                {c.product && (
                  <div class="flex justify-start mb-2">
                    <span class="inline-flex items-center gap-1 text-[#1A1815]/60 text-[10px] font-medium">
                      <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="#C8862C" stroke="#C8862C" stroke-width="1" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                      {c.product.rating}
                    </span>
                  </div>
                )}

                {!c.product && (
                  <div class="flex justify-start mb-2">
                    <a
                      href={`/productlist?category=${encodeURIComponent(categoryMap[c.slug] || 'All')}`}
                      class="bg-[#1A1815]/10 hover:bg-[#1A1815]/15 text-[#1A1815] text-[9px] uppercase tracking-[0.15em] px-3 py-1.5 rounded-full font-medium transition-colors"
                    >
                      Notify me
                    </a>
                  </div>
                )}

                <!-- Explore all — centred, dark grey -->
                <div class="flex justify-center">
                  <a
                    href={`/productlist?category=${encodeURIComponent(categoryMap[c.slug] || 'All')}`}
                    class="inline-flex items-center gap-2 text-[#1A1815]/70 hover:text-[#1A1815] text-[11px] uppercase tracking-[0.22em] font-medium transition-colors duration-200"
                  >
                    Explore all
                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
                  </a>
                </div>
              </div>

            </div>
          </div>
        ))}
      </div>
    </div>


    <!-- ════════════════════════════════════════════
         DESKTOP  –  3-column card grid (hidden on mobile)
         ════════════════════════════════════════════ -->
    <div class="hidden md:grid grid-cols-3 gap-5">
      {categories.map((c) => (
        <div
          data-testid={`category-${c.slug}`}
          class="fade-up group relative overflow-hidden aspect-[3/4]"
          
        >

          <!-- Product image: contained, floats on pastel bg -->
          <a
            href={`/productlist?category=${encodeURIComponent(categoryMap[c.slug] || 'All')}`}
            data-testid={`category-link-${c.slug}`}
            aria-label={`Browse ${c.name} collection`}
            class="absolute inset-0 z-0 flex items-center justify-center p-8 pb-20"
          >
            {c.product?.img ? (
              <img
                src={c.product.img.src}
                alt={c.product.name}
                class="w-full h-full object-contain drop-shadow-[0_12px_32px_rgba(0,0,0,0.10)] transition-transform duration-[1000ms] ease-out group-hover:scale-105"
              />
            ) : (
              <div class="flex flex-col items-center justify-center gap-3 opacity-35">
                <svg xmlns="http://www.w3.org/2000/svg" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="rgba(26,24,21,0.5)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
                <span class="text-[11px] uppercase tracking-[0.2em] text-[#4A453E]/60">Coming soon</span>
              </div>
            )}
          </a>

          <!-- Subtle bottom fade using the card's own bg — no dark overlay -->
          <div
  class="absolute inset-0 pointer-events-none"
  style={`
    background:
      radial-gradient(
        ellipse 40% 18% at 50% 72%,
        rgba(55, 55, 55, 0.18) 0%,
        rgba(55, 55, 55, 0.10) 35%,
        rgba(55, 55, 55, 0.04) 60%,
        transparent 100%
      );
  `}
/>

          <!-- TOP: category name (left) + Buy now for price (right) -->
          <div class="absolute top-0 left-0 right-0 flex items-start justify-between p-4 z-20">
            <a
              href={`/productlist?category=${encodeURIComponent(categoryMap[c.slug] || 'All')}`}
              data-testid={`category-label-${c.slug}`}
              class="font-serif-display text-2xl lg:text-3xl text-[#1A1815] leading-tight hover:opacity-70 transition-opacity duration-300"
            >
              {c.name}
            </a>

            {c.product && (
              <a
                href={`/productdetail/${toSlug(c.product.name)}`}
                data-testid={`product-buy-${c.product.id}`}
                aria-label={`Buy ${c.product.name}`}
                class="flex-shrink-0 ml-2 bg-[#1A1815] hover:bg-[#C8862C] text-white text-[10px] uppercase tracking-[0.12em] px-4 py-2 rounded-full inline-flex items-center gap-2 transition-all duration-300 shadow-sm font-medium whitespace-nowrap"
              >
                Buy now for {c.product.price}
              </a>
            )}
          </div>

          <!-- Rating: subtle, just below the name -->
          {c.product && (
            <div class="absolute top-[4.2rem] left-4 z-20">
              <span class="inline-flex items-center gap-1 text-[#1A1815]/55 text-[11px] font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="#C8862C" stroke="#C8862C" stroke-width="1" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {c.product.rating}
              </span>
            </div>
          )}

          <!-- BOTTOM: notify (no product, left) + Explore all (right) -->
          <div class="absolute bottom-0 left-0 right-0 flex items-end justify-between p-4 z-20">
            {!c.product && (
              <a
                href={`/productlist?category=${encodeURIComponent(categoryMap[c.slug] || 'All')}`}
                class="bg-[#1A1815]/10 hover:bg-[#1A1815]/15 text-[#1A1815] text-[10px] uppercase tracking-[0.15em] px-4 py-2.5 rounded-full transition-colors duration-300 font-medium"
              >
                Notify me
              </a>
            )}
            {c.product && <span />}

            <a
              href={`/productlist?category=${encodeURIComponent(categoryMap[c.slug] || 'All')}`}
              aria-label={`Explore all ${c.name}`}
              class="group/exp inline-flex items-center gap-1.5 text-[#1A1815]/60 hover:text-[#1A1815] text-[10px] uppercase tracking-[0.2em] font-medium transition-all duration-300"
            >
              Explore all
              <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-300 group-hover/exp:translate-x-0.5 group-hover/exp:-translate-y-0.5">
                <path d="M7 17L17 7"/>
                <path d="M7 7h10v10"/>
              </svg>
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>