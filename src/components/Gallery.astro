---
import { supabase } from "../lib/supabase";
import { getImageUrl } from "../lib/images";
import HERO from "../assets/sun_on_desk.png";
import STARS from "../assets/stars.png";
import DINO from "../assets/green-dino.jpg";
import SUNMOON from "../assets/sun_and_moon.jpg";
import SUN_CLOSEUP from "../assets/sun_on_desk_closeup.png";
import SPIDEY from "../assets/spiderman.jpg";

const { data: dbTiles } = await supabase
  .from("gallery_items")
  .select("storage_path, alt_text, span_class, instagram_url, display_order")
  .eq("is_active", true)
  .order("display_order");

const localTiles = [
  {
    src: HERO.src,
    span: "span-2col span-2row",
    alt: "Crochet sun on pegboard",
    caption: "Crocheted with love ♡",
    rotation: "rot-neg3",
    deco: "tape-topleft-pink",
  },
  {
    src: STARS.src,
    span: "",
    alt: "Crochet stars",
    caption: "little stars ✦",
    rotation: "rot-pos2",
    deco: "clip-top",
  },
  {
    src: DINO.src,
    span: "",
    alt: "Dino keychain",
    caption: "tiny treasures",
    rotation: "rot-neg1",
    deco: "tape-topright-green",
  },
  {
    src: SUNMOON.src,
    span: "span-wide",
    alt: "Sun and moon set",
    caption: "sun & moon — made for each other ☽",
    rotation: "rot-pos3",
    deco: "tape-topcenter-green",
  },
  {
    src: SUN_CLOSEUP.src,
    span: "",
    alt: "Sun close-up",
    caption: "golden hour",
    rotation: "rot-neg2",
    deco: "clip-top",
  },
  {
    src: SPIDEY.src,
    span: "",
    alt: "Spidey hanging",
    caption: "made with love ♡",
    rotation: "rot-pos1",
    deco: "tape-topcenter-pink",
  },
];

const decoMeta = localTiles.map(({ caption, rotation, deco }) => ({
  caption,
  rotation,
  deco,
}));

const tiles =
  dbTiles && dbTiles.length > 0
    ? dbTiles.map((t, i) => ({
        src: getImageUrl(t.storage_path, "gallery-images"),
        span: t.span_class ?? "",
        alt: t.alt_text ?? "",
        caption: decoMeta[i]?.caption ?? "",
        rotation: decoMeta[i]?.rotation ?? "rot-neg1",
        deco: decoMeta[i]?.deco ?? "clip-top",
      }))
    : localTiles;
---

<section id="gallery" data-testid="gallery" class="gallery-section">
  <!-- Scattered background decorations -->
  <div class="deco-layer" aria-hidden="true">
    <svg
      class="deco sprig-left"
      width="36"
      height="50"
      viewBox="0 0 36 50"
      fill="none"
    >
      <path d="M18 50 Q17 35 18 10" stroke="#8aaa7a" stroke-width="1.4"></path>
      <path d="M18 40 Q12 35 8 30" stroke="#8aaa7a" stroke-width="1"></path>
      <circle cx="8" cy="30" r="2.5" fill="#e8b4b0" opacity="0.8"></circle>
      <path d="M18 32 Q24 27 28 22" stroke="#8aaa7a" stroke-width="1"></path>
      <circle cx="28" cy="22" r="2.5" fill="#e8b4b0" opacity="0.8"></circle>
      <circle cx="18" cy="10" r="3" fill="#e8b4b0" opacity="0.8"></circle>
    </svg>

    <svg
      class="deco sprig-right"
      width="36"
      height="50"
      viewBox="0 0 36 50"
      fill="none"
    >
      <path d="M18 50 Q17 35 18 10" stroke="#8aaa7a" stroke-width="1.4"></path>
      <path d="M18 40 Q12 35 8 30" stroke="#8aaa7a" stroke-width="1"></path>
      <circle cx="8" cy="30" r="2.5" fill="#e8b4b0" opacity="0.8"></circle>
      <path d="M18 32 Q24 27 28 22" stroke="#8aaa7a" stroke-width="1"></path>
      <circle cx="28" cy="22" r="2.5" fill="#e8b4b0" opacity="0.8"></circle>
      <circle cx="18" cy="10" r="3" fill="#e8b4b0" opacity="0.8"></circle>
    </svg>

    <svg
      class="deco flower-tl"
      width="42"
      height="52"
      viewBox="0 0 42 52"
      fill="none"
    >
      <path
        d="M21 6 Q24 1 27 6 Q32 2 31 8 Q36 7 34 13 Q39 15 36 20 Q40 24 36 27 Q38 32 33 33 Q33 38 28 38 Q26 44 21 43 Q16 44 14 38 Q9 38 9 33 Q4 32 6 27 Q2 24 6 20 Q3 15 8 13 Q6 7 11 8 Q10 2 15 6 Q18 1 21 6Z"
        fill="#e8b4b0"
        opacity="0.6"></path>
      <circle cx="21" cy="22" r="5" fill="#f2d5a0"></circle>
      <path d="M21 43 Q20 48 21 52" stroke="#7a9e6e" stroke-width="1.5"></path>
      <path d="M21 47 Q17 44 15 41" stroke="#7a9e6e" stroke-width="1.2"></path>
      <path d="M21 47 Q25 44 27 41" stroke="#7a9e6e" stroke-width="1.2"></path>
    </svg>

    <svg
      class="deco flower-tr"
      width="38"
      height="48"
      viewBox="0 0 42 52"
      fill="none"
    >
      <path
        d="M21 6 Q24 1 27 6 Q32 2 31 8 Q36 7 34 13 Q39 15 36 20 Q40 24 36 27 Q38 32 33 33 Q33 38 28 38 Q26 44 21 43 Q16 44 14 38 Q9 38 9 33 Q4 32 6 27 Q2 24 6 20 Q3 15 8 13 Q6 7 11 8 Q10 2 15 6 Q18 1 21 6Z"
        fill="#a8c49a"
        opacity="0.7"></path>
      <circle cx="21" cy="22" r="5" fill="#f2d5a0"></circle>
      <path d="M21 43 Q20 48 21 52" stroke="#7a9e6e" stroke-width="1.5"></path>
    </svg>

    <svg class="deco butterfly-1" width="18" height="14" viewBox="0 0 18 14">
      <path d="M9 7 Q5 2 1 3 Q2 8 9 7Z" fill="#e8b4b0"></path>
      <path d="M9 7 Q13 2 17 3 Q16 8 9 7Z" fill="#e8b4b0"></path>
      <path d="M9 7 Q5 10 2 11 Q3 7 9 7Z" fill="#d4a09c" opacity="0.7"></path>
      <path d="M9 7 Q13 10 16 11 Q15 7 9 7Z" fill="#d4a09c" opacity="0.7"
      ></path>
    </svg>

    <svg class="deco butterfly-2" width="16" height="12" viewBox="0 0 18 14">
      <path d="M9 7 Q5 2 1 3 Q2 8 9 7Z" fill="#e8b4b0"></path>
      <path d="M9 7 Q13 2 17 3 Q16 8 9 7Z" fill="#e8b4b0"></path>
      <path d="M9 7 Q5 10 2 11 Q3 7 9 7Z" fill="#d4a09c" opacity="0.7"></path>
      <path d="M9 7 Q13 10 16 11 Q15 7 9 7Z" fill="#d4a09c" opacity="0.7"
      ></path>
    </svg>

    <svg
      class="deco heart-bl"
      width="28"
      height="24"
      viewBox="0 0 28 24"
      fill="none"
    >
      <path
        d="M14 21 C10 17 2 13 2 7 C2 3 5 1 8 1 C11 1 13 4 14 5 C15 4 17 1 20 1 C23 1 26 3 26 7 C26 13 18 17 14 21Z"
        stroke="#c4714a"
        stroke-width="1.5"></path>
    </svg>
  </div>

  <!-- Section header -->
  <div class="section-header">
    <div>
      <p class="section-label fade-up">@sunflora.craft</p>
      <h2 class="section-title fade-up">
        <em>Lived-in,</em><br />loved-in.
      </h2>
    </div>
    <a href="#cta" data-testid="gallery-follow" class="follow-link fade-up">
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
      </svg>
      Follow on Instagram
    </a>
  </div>

  <!-- Photo grid -->
  <div class="photo-grid">
    {
      tiles.map((t) => (
        <div class={`photo-card fade-up ${t.span} ${t.rotation}`}>
          {t.deco === "tape-topleft-pink" && (
            <span class="tape tape-pink tape-top-left" aria-hidden="true" />
          )}
          {t.deco === "tape-topright-green" && (
            <span class="tape tape-green tape-top-right" aria-hidden="true" />
          )}
          {t.deco === "tape-topcenter-pink" && (
            <span class="tape tape-pink tape-top-center" aria-hidden="true" />
          )}
          {t.deco === "tape-topcenter-green" && (
            <span class="tape tape-green tape-top-center" aria-hidden="true" />
          )}
          {t.deco === "clip-top" && (
            <svg
              class="clip clip-top"
              width="22"
              height="36"
              viewBox="0 0 22 36"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M11 2 C6 2 3 5 3 9 L3 28 C3 32 6 34 11 34 C16 34 19 32 19 28 L19 11 C19 7 16 5 11 5 C6 5 6 8 6 11 L6 27 C6 29 8 30 11 30 C14 30 16 29 16 27 L16 12"
                stroke="#c8945a"
                stroke-width="2"
                stroke-linecap="round"
              />
            </svg>
          )}

          <div class="photo-inner">
            <img src={t.src} alt={t.alt} loading="lazy" decoding="async" />
            {t.caption && <span class="photo-caption">{t.caption}</span>}
          </div>
        </div>
      ))
    }
  </div>

  <!-- CTA -->
  <div class="cta-wrap">
    <a href="#collection" class="cta-btn">
      Explore Our Collection
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
      </svg>
    </a>
    <svg
      class="cta-divider"
      width="120"
      height="16"
      viewBox="0 0 120 16"
      aria-hidden="true"
    >
      <line x1="0" y1="8" x2="46" y2="8" stroke="#c4714a" stroke-width="0.8"
      ></line>
      <circle cx="52" cy="8" r="1.5" fill="#e8b4b0"></circle>
      <circle cx="60" cy="8" r="3" fill="#e8b4b0"></circle>
      <circle cx="68" cy="8" r="1.5" fill="#e8b4b0"></circle>
      <line x1="74" y1="8" x2="120" y2="8" stroke="#c4714a" stroke-width="0.8"
      ></line>
    </svg>
  </div>
</section>

<!-- Fade-up observer — scoped to this component -->
<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target); // fire once
        }
      });
    },
    { threshold: 0.12 },
  );

  document
    .querySelectorAll("#gallery .fade-up")
    .forEach((el) => observer.observe(el));
</script>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,400&family=Caveat:wght@500&family=Lato:wght@300;400&display=swap");

  /* ── Section ─────────────────────────────────────────── */
  .gallery-section {
    position: relative;
    padding: 6rem 3rem 7rem;
    overflow: hidden;
  }

  /* ── Deco layer ──────────────────────────────────────── */
  .deco-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    user-select: none;
  }

  .deco {
    position: absolute;
  }

  .sprig-left {
    top: 18px;
    left: 280px;
    opacity: 0.35;
  }
  .sprig-right {
    top: 20px;
    right: 240px;
    opacity: 0.35;
    transform: scaleX(-1);
  }
  .flower-tl {
    top: 18px;
    left: 60px;
    opacity: 0.5;
  }
  .flower-tr {
    top: 30px;
    right: 80px;
    opacity: 0.45;
    transform: rotate(15deg);
  }
  .butterfly-1 {
    top: 100px;
    left: 200px;
    opacity: 0.4;
  }
  .butterfly-2 {
    top: 60px;
    right: 220px;
    opacity: 0.35;
    transform: rotate(30deg);
  }
  .heart-bl {
    bottom: 24px;
    left: 36px;
    opacity: 0.35;
  }

  /* ── Header ──────────────────────────────────────────── */
  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3rem;
    position: relative;
    z-index: 2;
  }

  .section-label {
    font-family: "Lato", sans-serif;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #c4714a;
    margin: 0 0 0.5rem;
  }

  .section-title {
    font-family: "Playfair Display", serif;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 600;
    color: #2d1f14;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .section-title em {
    font-style: italic;
    font-weight: 400;
  }

  .follow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "Lato", sans-serif;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #2d1f14;
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid #2d1f14;
    transition: opacity 0.2s ease;
  }
  .follow-link:hover {
    opacity: 0.55;
  }

  /* ── Grid ────────────────────────────────────────────── */
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 260px;
    gap: 1.25rem;
    position: relative;
    z-index: 2;
  }

  .span-2col {
    grid-column: span 2;
  }
  .span-2row {
    grid-row: span 2;
  }
  .span-wide {
    grid-column: span 2;
  }

  /* ── Card ────────────────────────────────────────────── */
  .photo-card {
    position: relative;
  }

  .photo-card.is-visible:hover {
    z-index: 10;
    --rotate: var(--rotate-hover, 0deg);
    --scale: 1.02;
  }

  .rot-neg3 {
    --rotate: -3deg;
    --rotate-hover: -1deg;
  }
  .rot-pos2 {
    --rotate: 2deg;
    --rotate-hover: 1deg;
  }
  .rot-neg1 {
    --rotate: -1deg;
    --rotate-hover: 0deg;
  }
  .rot-pos3 {
    --rotate: 3deg;
    --rotate-hover: 1.5deg;
  }
  .rot-neg2 {
    --rotate: -2deg;
    --rotate-hover: -1deg;
  }
  .rot-pos1 {
    --rotate: 1deg;
    --rotate-hover: 0deg;
  }

  /* Polaroid frame */
  .photo-inner {
    width: 100%;
    height: 100%;
    background: #fff;
    padding: 8px 8px 36px;
    border-radius: 3px;
    box-shadow:
      2px 4px 12px rgba(90, 55, 30, 0.14),
      0 1px 3px rgba(90, 55, 30, 0.08);
    box-sizing: border-box;
    overflow: hidden;
    position: relative;
  }

  .photo-inner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 2px;
    display: block;
    transition: transform 1.5s ease-out;
  }
  .photo-card:hover .photo-inner img {
    transform: scale(1.04);
  }

  .photo-caption {
    font-family: "Caveat", cursive;
    font-size: 14px;
    font-weight: 500;
    color: #5a3a22;
    text-align: center;
    position: absolute;
    bottom: 6px;
    left: 0;
    right: 0;
    line-height: 1.2;
  }

  /* ── Washi tape ──────────────────────────────────────── */
  .tape {
    position: absolute;
    width: 52px;
    height: 34px;
    border-radius: 2px;
    opacity: 0.85;
    z-index: 5;
    display: block;
  }

  .tape-pink {
    background: repeating-linear-gradient(
      45deg,
      #e8a0a0 0,
      #e8a0a0 3px,
      #f5c8c8 3px,
      #f5c8c8 6px
    );
  }

  .tape-green {
    background: repeating-linear-gradient(
      45deg,
      #a3bc97 0,
      #a3bc97 3px,
      #c5d9be 3px,
      #c5d9be 6px
    );
  }

  .tape-top-left {
    top: -9px;
    left: 12px;
    transform: rotate(-4deg);
  }
  .tape-top-right {
    top: -9px;
    right: 12px;
    transform: rotate(3deg);
  }
  .tape-top-center {
    top: -9px;
    left: 50%;
    transform: translateX(-50%) rotate(-2deg);
  }

  /* ── Paperclip ───────────────────────────────────────── */
  .clip {
    position: absolute;
    z-index: 6;
  }
  .clip-top {
    top: -14px;
    right: 18px;
  }

  /* ── CTA ─────────────────────────────────────────────── */
  .cta-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    margin-top: 3rem;
    position: relative;
    z-index: 2;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    background: #8aaa7a;
    color: #fff;
    padding: 14px 32px;
    border-radius: 100px;
    font-family: "Lato", sans-serif;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 2px 12px rgba(138, 170, 122, 0.35);
    transition:
      background 0.2s ease,
      transform 0.15s ease;
  }
  .cta-btn:hover {
    background: #7a9a6a;
    transform: translateY(-1px);
  }
  .cta-btn:active {
    transform: translateY(0);
  }

  .cta-divider {
    opacity: 0.4;
  }

  /* ── Fade-up ─────────────────────────────────────────── */
  .fade-up {
    opacity: 0;
    --translate-y: 20px;
    --scale: 1;
    transform: translateY(var(--translate-y)) rotate(var(--rotate, 0deg)) scale(var(--scale));
    transition:
      opacity 0.6s ease,
      transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .fade-up.is-visible {
    opacity: 1;
    --translate-y: 0px;
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 768px) {
    .gallery-section {
      padding: 3rem 1.25rem 4rem;
    }
    .photo-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 200px;
      gap: 1rem;
    }
    .span-2row {
      grid-row: span 1;
    }
  }

  @media (max-width: 480px) {
    .photo-grid {
      grid-auto-rows: 160px;
    }
  }

  /* Respect reduced-motion preference */
  @media (prefers-reduced-motion: reduce) {
    .photo-card,
    .photo-inner img,
    .fade-up {
      transition: none;
    }
  }
</style>
