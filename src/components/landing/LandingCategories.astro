---
const categories = [
  {
    name: "Flower Bouquets",
    img: "/images/landing/lify-bouquet.PNG",
    price: "₹999",
    link: "/productlist?category=Bouquets",
  },
  {
    name: "Soft Toys",
    img: "/images/landing/hanuman.PNG",
    price: "₹499",
    link: "/productlist?category=Amigurumi",
  },
  {
    name: "Flower Pots",
    img: "/images/landing/flower_pot.PNG",
    price: "₹399",
    link: "/productlist?category=Wall Hangings",
  },
  {
    name: "Cushions",
    img: "/images/landing/cushion.PNG",
    price: "₹249",
    link: "/productlist?category=Keychains",
  },
];
---

<section id="categories" class="kn-section cat-section">
  <div class="kn-container">
    <!-- Section Header -->
    <div class="cat-header kn-fade-up">
      <span class="cat-floral"></span>
      <h2 class="kn-section-title">Browse Our Collection</h2>
      <p class="kn-section-subtitle">
        From bouquets to plushies — find your next favourite piece
      </p>
    </div>

    <!-- Category Grid -->
    <div class="cat-grid">
      {
        categories.map((cat, i) => (
          <a
            href={cat.link}
            class={`cat-card kn-fade-up`}
            style={`transition-delay: ${i * 0.1}s`}
          >
            <div class="cat-img-wrap">
              <img
                src={cat.img}
                alt={cat.name}
                loading="lazy"
                class="cat-img"
              />
              <div class="cat-overlay">
                <h3 class="cat-name">{cat.name}</h3>
                <p class="cat-price-row">
                  <span class="cat-price">
                    From <strong>{cat.price}</strong>
                  </span>
                  <span class="cat-arrow" aria-hidden="true">→</span>
                </p>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cat-section {
    background: var(--kn-white);
  }

  .cat-header {
    text-align: center;
    margin-bottom: 56px;
  }

  .cat-floral {
    font-size: 28px;
    display: block;
    margin-bottom: 12px;
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: start;
    gap: 24px;
  }

  .cat-card {
    background: var(--kn-white);
    border-radius: 0;
    overflow: hidden;
    text-decoration: none;
    transition:
      transform 0.4s ease,
      box-shadow 0.4s ease;
    border: 1px solid transparent;
  }

  .cat-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 48px rgba(92, 61, 46, 0.12);
    border-color: var(--kn-taupe);
  }

  /* Card = the picture itself, sized to the image's own dimensions — no forced/cropped aspect box */
  .cat-img-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--kn-white);
  }

  .cat-img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.5s ease;
  }

  .cat-card:hover .cat-img {
    transform: scale(1.06);
  }

  .cat-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 16px;
  }

  .cat-name {
    font-family: var(--kn-font-heading);
    font-size: 17px;
    font-weight: 600;
    color: #000;
    text-shadow:
      0 1px 3px rgba(255, 255, 255, 0.8),
      0 0 8px rgba(255, 255, 255, 0.6);
  }

  .cat-price-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-shrink: 0;
  }

  .cat-price {
    font-family: var(--kn-font-body);
    font-size: 13px;
    color: #000;
    text-shadow:
      0 1px 3px rgba(255, 255, 255, 0.8),
      0 0 8px rgba(255, 255, 255, 0.6);
  }

  .cat-price strong {
    font-weight: 700;
  }

  .cat-arrow {
    font-family: var(--kn-font-body);
    font-size: 13px;
    font-weight: 700;
    color: var(--kn-rose);
    text-shadow:
      0 1px 3px rgba(255, 255, 255, 0.8),
      0 0 8px rgba(255, 255, 255, 0.6);
    transition: transform 0.3s ease;
  }

  .cat-card:hover .cat-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 1024px) {
    .cat-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 640px) {
    .cat-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
    .cat-overlay {
      padding: 10px 12px;
    }
    .cat-name {
      font-size: 15px;
    }
  }
</style>
