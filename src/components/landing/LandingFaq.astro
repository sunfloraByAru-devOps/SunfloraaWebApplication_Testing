---
import {
  getFaqGroups,
  getHomeFaqs,
  type FaqGroup,
} from "../../lib/site-content";

interface Props {
  /** "compact" = 4-question homepage teaser, "full" = all groups on /faq */
  variant?: "compact" | "full";
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  /** Hide the section header when the page supplies its own hero */
  showHeader?: boolean;
}

const {
  variant = "compact",
  eyebrow = "The asked things",
  title = "Curious?",
  subtitle = "The things people write to us about most — answered honestly.",
  showHeader = true,
} = Astro.props;

/* Both variants render the same shape: a list of groups. The compact one is a
   single untitled group, so the markup below never branches.

   Frontmatter runs at build time, so awaiting the database here costs nothing
   at request time — the answers are baked into the static HTML. Only the
   variant actually being rendered is fetched. */
const groups: FaqGroup[] =
  variant === "full"
    ? await getFaqGroups()
    : [{ id: "home", title: "", items: await getHomeFaqs() }];
---

<section id="faq" class="kn-section faq-section">
  <div class="kn-container">
    {
      showHeader && (
        <div class="faq-header kn-fade-up">
          <span class="faq-eyebrow">{eyebrow}</span>
          <h2 class="kn-section-title">
            {title} <em>Same.</em>
          </h2>
          <p class="kn-section-subtitle">{subtitle}</p>
        </div>
      )
    }

    <div class="faq-wrap">
      {
        groups.map((group) => (
          <div class="faq-group" id={variant === "full" ? group.id : undefined}>
            {group.title && (
              <div class="faq-group-head kn-fade-up">
                <h2 class="faq-group-title">{group.title}</h2>
                {group.blurb && <p class="faq-group-blurb">{group.blurb}</p>}
              </div>
            )}

            <div class="faq-list">
              {group.items.map((item, i) => {
                const bodyId = `faq-${group.id}-${i}`;
                const open = "defaultOpen" in item && item.defaultOpen === true;
                return (
                  <div
                    class="faq-item kn-fade-up"
                    style={`transition-delay: ${i * 0.08}s`}
                  >
                    <h3 class="faq-q-head">
                      <button
                        class="faq-trigger"
                        type="button"
                        aria-expanded={open ? "true" : "false"}
                        aria-controls={bodyId}
                        data-target={bodyId}
                      >
                        <span class="faq-q">{item.q}</span>
                        <svg
                          class="faq-icon"
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          aria-hidden="true"
                        >
                          <line x1="12" y1="5" x2="12" y2="19" />
                          <line x1="5" y1="12" x2="19" y2="12" />
                        </svg>
                      </button>
                    </h3>

                    <div class={`faq-body${open ? " open" : ""}`} id={bodyId}>
                      <div class="faq-inner">
                        <p class="faq-a">{item.a}</p>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        ))
      }
    </div>

    {
      variant === "compact" && (
        <div class="faq-footer kn-fade-up">
          <a href="/faq" class="kn-view-all">
            Read all FAQs →
          </a>
          <span class="faq-sep">·</span>
          <a href="/contact" class="faq-contact">
            Still stuck? Write to us ♡
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .faq-section {
    background: var(--kn-white);
  }

  .faq-header {
    text-align: center;
    margin-bottom: 56px;
  }

  .faq-eyebrow {
    display: block;
    font-family: var(--kn-font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--kn-rose);
    margin-bottom: 14px;
  }

  .kn-section-title em {
    font-style: normal;
    color: var(--kn-rose);
  }

  .faq-wrap {
    max-width: 820px;
    margin: 0 auto;
  }

  .faq-group + .faq-group {
    margin-top: 56px;
  }

  /* Offset anchor jumps so the fixed 72px header never covers a group title */
  .faq-group[id] {
    scroll-margin-top: 110px;
  }

  .faq-group-head {
    margin-bottom: 8px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--kn-taupe);
  }

  .faq-group-title {
    font-family: var(--kn-font-heading);
    font-size: 22px;
    font-weight: 700;
    color: var(--kn-brown);
    margin: 0 0 6px;
  }

  .faq-group-blurb {
    font-family: var(--kn-font-body);
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--kn-brown-muted);
    margin: 0;
    max-width: 560px;
  }

  .faq-item {
    border-bottom: 1px solid var(--kn-taupe-light);
  }

  .faq-q-head {
    margin: 0;
    font: inherit;
  }

  .faq-trigger {
    width: 100%;
    min-height: 44px;
    background: none;
    border: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 0;
    cursor: pointer;
    text-align: left;
    font-family: var(--kn-font-body);
    color: var(--kn-brown);
    transition: color 0.3s ease;
  }

  .faq-trigger:hover,
  .faq-trigger:focus-visible {
    color: var(--kn-rose);
  }

  .faq-q {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
  }

  .faq-icon {
    flex-shrink: 0;
    color: var(--kn-brown-muted);
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .faq-trigger:hover .faq-icon {
    color: var(--kn-rose);
  }

  .faq-trigger[aria-expanded="true"] {
    color: var(--kn-rose);
  }

  .faq-trigger[aria-expanded="true"] .faq-icon {
    transform: rotate(45deg);
    color: var(--kn-rose);
  }

  .faq-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
    overflow: hidden;
  }

  .faq-body.open {
    grid-template-rows: 1fr;
  }

  .faq-inner {
    min-height: 0;
  }

  .faq-a {
    font-family: var(--kn-font-body);
    font-size: 15px;
    line-height: 1.75;
    color: var(--kn-brown-light);
    padding: 0 40px 24px 0;
    margin: 0;
  }

  .faq-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 44px;
  }

  .faq-sep {
    color: var(--kn-brown-muted);
  }

  .faq-contact {
    font-family: var(--kn-font-body);
    font-size: 13px;
    color: var(--kn-brown-light);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .faq-contact:hover {
    color: var(--kn-rose);
  }

  @media (max-width: 640px) {
    .faq-header {
      margin-bottom: 40px;
    }

    .faq-q {
      font-size: 14px;
    }

    .faq-a {
      font-size: 14px;
      padding-right: 8px;
    }

    .faq-group + .faq-group {
      margin-top: 40px;
    }

    .faq-group-title {
      font-size: 19px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-body,
    .faq-icon,
    .faq-trigger {
      transition: none;
    }
  }
</style>

<script>
  // Independent open/close — unlike the product-page accordion, several FAQ
  // answers can usefully be open at once.
  document.querySelectorAll<HTMLButtonElement>(".faq-trigger").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const expanded = trigger.getAttribute("aria-expanded") === "true";
      const body = document.getElementById(trigger.dataset.target ?? "");
      trigger.setAttribute("aria-expanded", String(!expanded));
      body?.classList.toggle("open", !expanded);
    });
  });
</script>
