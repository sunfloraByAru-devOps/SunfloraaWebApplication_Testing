---
/* Best Sellers section — product grid with prices */
const products = [
  {
    name: "Cozy Teddy Bear",
    img: "/images/landing/prod-teddy.png",
    price: "₹1,199",
  },
  {
    name: "Crochet Flower Basket",
    img: "/images/landing/prod-basket.png",
    price: "₹499",
  },
  {
    name: "Tulip Bouquet",
    img: "/images/landing/prod-tulips.png",
    price: "₹899",
  },
  {
    name: "Pink Bunny Amigurumi",
    img: "/images/landing/prod-bunny.png",
    price: "₹299",
  },
  {
    name: "Round Cushion",
    img: "/images/landing/prod-pillow.png",
    price: "₹849",
  },
];
---

<section id="best-sellers" class="kn-section">
  <div class="kn-container">
    <!-- Header row -->
    <div class="sellers-header kn-fade-up">
      <div class="sellers-title-wrap">
        <h2 class="kn-section-title" style="text-align:left; margin-bottom:0;">
          Best Sellers 🔥
        </h2>
      </div>
      <a href="/productlist" class="kn-view-all">View All →</a>
    </div>

    <!-- Product row -->
    <div class="sellers-grid">
      {
        products.map((p, i) => (
          <div
            class={`kn-product-card kn-fade-up`}
            style={`transition-delay: ${i * 0.08}s`}
          >
            <div class="card-img-wrap">
              <img src={p.img} alt={p.name} loading="lazy" class="card-img" />
              <button
                class="wishlist-btn"
                aria-label={`Add ${p.name} to wishlist`}
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                </svg>
              </button>
            </div>
            <div class="card-body">
              <p class="card-title">{p.name}</p>
              <p class="card-price">{p.price}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .sellers-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .sellers-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
  }

  .card-img-wrap {
    position: relative;
    overflow: hidden;
    border-radius: var(--kn-radius-md) var(--kn-radius-md) 0 0;
  }

  .wishlist-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--kn-brown-muted);
    transition: all 0.3s ease;
    opacity: 0;
    transform: translateY(-4px);
  }

  .kn-product-card:hover .wishlist-btn {
    opacity: 1;
    transform: translateY(0);
  }

  .wishlist-btn:hover {
    color: var(--kn-rose);
    background: white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  @media (max-width: 1024px) {
    .sellers-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .sellers-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
    .sellers-header {
      flex-direction: column;
      gap: 12px;
      align-items: flex-start;
    }
  }
</style>
