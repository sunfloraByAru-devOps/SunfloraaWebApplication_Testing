---
/* Best Sellers section — horizontal carousel, left-aligned with veil on right */
const products = [
  {
    name: "Cozy Teddy Bear",
    img: "/images/landing/prod-teddy.png",
    price: "₹1,199",
  },
  {
    name: "Crochet Flower Basket",
    img: "/images/landing/prod-basket.png",
    price: "₹499",
  },
  {
    name: "Tulip Bouquet",
    img: "/images/landing/prod-tulips.png",
    price: "₹899",
  },
  {
    name: "Pink Bunny Amigurumi",
    img: "/images/landing/prod-bunny.png",
    price: "₹299",
  },
  {
    name: "Round Cushion",
    img: "/images/landing/prod-pillow.png",
    price: "₹849",
  },
];
---

<section id="best-sellers" class="kn-section">
  <div class="kn-container">
    <!-- Header row — left aligned -->
    <div class="sellers-header kn-fade-up">
      <div class="sellers-title-wrap">
        <h2 class="kn-section-title" style="text-align:left; margin-bottom:0;">
          Most Loved
        </h2>
        <p class="kn-section-subtitle">
          100+ orders on these products every month
        </p>
      </div>
      <a href="/productlist" class="kn-view-all">View All →</a>
    </div>

    <!-- Carousel with veil on right -->
    <div class="sellers-carousel-wrap">
      <div class="sellers-carousel" id="sellers-carousel">
        {
          products.map((p, i) => (
            <div
              class="kn-product-card carousel-card kn-fade-up"
              style={`transition-delay: ${i * 0.08}s`}
            >
              <div class="card-img-wrap">
                <img src={p.img} alt={p.name} loading="lazy" class="card-img" />
                <button
                  class="wishlist-btn"
                  aria-label={`Add ${p.name} to wishlist`}
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                  </svg>
                </button>
              </div>
              <div class="card-body">
                <p class="card-title">{p.name}</p>
                <p class="card-price">{p.price}</p>
              </div>
            </div>
          ))
        }
      </div>
      <!-- Gradient veil on right edge with arrow -->
      <div class="sellers-veil" aria-hidden="true">
        <svg
          class="veil-arrow"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="var(--kn-rose, #D4708F)"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .kn-section-subtitle {
    font-size: 0.95rem;
    color: #8a6d5c; /* muted rust/brown, matches your View All link */
    margin-top: 4px;
    margin-bottom: 0;
    font-weight: 500;
  }
  .sellers-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 40px;
  }

  /* ── Carousel wrapper — left-aligned, ~80% width ── */
  .sellers-carousel-wrap {
    position: relative;
    width: 82%;
    /* left-aligned by default (no margin-left) */
  }

  /* Gradient veil on right edge */
  .sellers-veil {
    position: absolute;
    top: 0;
    right: -1px;
    width: 80px;
    height: 100%;
    background: linear-gradient(to right, transparent, #ffffff);
    pointer-events: none;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sellers-veil .veil-arrow {
    opacity: 0.7;
    animation: arrowPulse 2s ease-in-out infinite;
  }

  @keyframes arrowPulse {
    0%,
    100% {
      transform: translateX(0);
      opacity: 0.7;
    }
    50% {
      transform: translateX(4px);
      opacity: 1;
    }
  }

  /* ── Carousel track ── */
  .sellers-carousel {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 8px;
  }

  .sellers-carousel::-webkit-scrollbar {
    display: none;
  }

  .sellers-carousel .carousel-card {
    flex: 0 0 calc((100% - 40px) / 3); /* 3 cards fill the narrower track */
    scroll-snap-align: start;
    min-width: 0;
  }

  .card-img-wrap {
    position: relative;
    overflow: hidden;
    border-radius: var(--kn-radius-md) var(--kn-radius-md) 0 0;
  }

  .wishlist-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--kn-brown-muted);
    transition: all 0.3s ease;
    opacity: 0;
    transform: translateY(-4px);
  }

  .kn-product-card:hover .wishlist-btn {
    opacity: 1;
    transform: translateY(0);
  }

  .wishlist-btn:hover {
    color: var(--kn-rose);
    background: white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  @media (max-width: 640px) {
    .kn-section-subtitle,
    .kn-section-subtitle-right {
      font-size: 0.8rem;
      margin-top: 2px;
      margin-bottom: 8px;
    }

    /* existing rules below stay as-is */
    .sellers-carousel-wrap {
      width: 90%;
    }
    .sellers-carousel .carousel-card {
      flex: 0 0 calc((100% - 14px) / 2);
    }
    .sellers-carousel {
      gap: 14px;
    }
    .sellers-header {
      flex-direction: column;
      gap: 12px;
      align-items: flex-start;
    }
    .sellers-veil {
      width: 50px;
    }
  }
</style>

<script>
  // Auto-scroll Best Sellers carousel to the LEFT periodically
  (() => {
    const carousel = document.getElementById("sellers-carousel");
    if (!carousel) return;

    const INTERVAL_MS = 3000;
    let timer: ReturnType<typeof setInterval>;

    function getCardWidth(): number {
      const card = carousel!.querySelector(
        ".carousel-card",
      ) as HTMLElement | null;
      if (!card) return 0;
      const style = getComputedStyle(carousel!);
      const gap = parseFloat(style.gap) || 20;
      return card.offsetWidth + gap;
    }

    function scrollOneLeft() {
      const cardW = getCardWidth();
      if (cardW === 0) return;
      const maxScroll = carousel!.scrollWidth - carousel!.clientWidth;

      if (carousel!.scrollLeft >= maxScroll - 2) {
        carousel!.scrollTo({ left: 0, behavior: "smooth" });
      } else {
        carousel!.scrollBy({ left: cardW, behavior: "smooth" });
      }
    }

    function startAutoScroll() {
      stopAutoScroll();
      timer = setInterval(scrollOneLeft, INTERVAL_MS);
    }

    function stopAutoScroll() {
      clearInterval(timer);
    }

    carousel.addEventListener("mouseenter", stopAutoScroll);
    carousel.addEventListener("mouseleave", startAutoScroll);
    carousel.addEventListener("touchstart", stopAutoScroll, { passive: true });
    carousel.addEventListener("touchend", () =>
      setTimeout(startAutoScroll, 2000),
    );

    const io = new IntersectionObserver(
      ([entry]) => {
        entry.isIntersecting ? startAutoScroll() : stopAutoScroll();
      },
      { threshold: 0.3 },
    );
    io.observe(carousel);
  })();
</script>
