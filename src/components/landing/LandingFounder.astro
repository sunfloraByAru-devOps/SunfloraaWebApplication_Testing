---
/* Loved by Many + A Note from Our Founder — side by side layout */
const favorites = [
  "/images/landing/prod-teddy.png",
  "/images/landing/cat-bouquet.png",
  "/images/landing/prod-bag.png",
  "/images/landing/prod-bunny.png",
];
---

<section id="about" class="kn-section founder-section">
  <div class="kn-container">
    <div class="founder-grid">
      <!-- Loved by Many -->
      <div class="loved-wrap kn-fade-up">
        <h3 class="loved-title">Loved by Many 🧡</h3>
        <div class="loved-gallery">
          {
            favorites.map((img, i) => (
              <div class="loved-item" style={`animation-delay: ${i * 0.15}s`}>
                <img
                  src={img}
                  alt="Customer favorite crochet product"
                  loading="lazy"
                  class="loved-img"
                />
              </div>
            ))
          }
        </div>
      </div>

      <!-- Founder Note -->
      <div class="founder-note kn-fade-up">
        <h3 class="founder-heading">A Note from Our Founder ✿</h3>
        <p class="founder-text">
          At Sunflora, every piece is more than just a product — it's a piece of
          our heart, our time, and our passion.
        </p>
        <p class="founder-text">
          Thank you for supporting handmade and being a part of our journey.
        </p>
        <div class="founder-sig">
          <p class="sig-text">With love,</p>
          <p class="sig-name">Ananya</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .founder-section {
    background: var(--kn-cream-alt);
  }

  .founder-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  /* Loved by Many */
  .loved-wrap {
    background: var(--kn-white);
    border-radius: var(--kn-radius-lg);
    padding: 28px;
    box-shadow: 0 4px 20px rgba(92, 61, 46, 0.06);
  }

  .loved-title {
    font-family: var(--kn-font-heading);
    font-size: 22px;
    font-weight: 600;
    color: var(--kn-brown);
    margin-bottom: 20px;
  }

  .loved-gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .loved-item {
    border-radius: var(--kn-radius-sm);
    overflow: hidden;
    aspect-ratio: 1;
  }

  .loved-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .loved-item:hover .loved-img {
    transform: scale(1.08);
  }

  /* Founder Note */
  .founder-note {
    background: var(--kn-white);
    border-radius: var(--kn-radius-lg);
    padding: 36px;
    box-shadow: 0 4px 20px rgba(92, 61, 46, 0.06);
  }

  .founder-heading {
    font-family: var(--kn-font-heading);
    font-size: 22px;
    font-weight: 600;
    color: var(--kn-brown);
    margin-bottom: 20px;
  }

  .founder-text {
    font-family: var(--kn-font-body);
    font-size: 14px;
    line-height: 1.8;
    color: var(--kn-brown-light);
    margin-bottom: 12px;
  }

  .founder-sig {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--kn-taupe-light);
  }

  .sig-text {
    font-family: var(--kn-font-body);
    font-size: 13px;
    color: var(--kn-brown-muted);
    margin-bottom: 4px;
  }

  .sig-name {
    font-family: var(--kn-font-script);
    font-size: 28px;
    color: var(--kn-rose);
  }

  @media (max-width: 1024px) {
    .founder-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 640px) {
    .loved-gallery {
      grid-template-columns: repeat(2, 1fr);
    }
    .loved-wrap,
    .founder-note {
      padding: 20px;
    }
  }
</style>
