---
import Logo from "../../assets/logo.png";
/* Full footer matching Sunflora reference */
const shopLinks = [
  { label: "All Products", href: "/productlist" },
  { label: "Best Sellers", href: "#best-sellers" },
  { label: "New Arrivals", href: "#new-arrivals" },
  { label: "Gift Cards", href: "#" },
];

const customerLinks = [
  { label: "FAQ", href: "#" },
  { label: "Shipping & Delivery", href: "#" },
  { label: "Returns & Refunds", href: "#" },
  { label: "Track Order", href: "#" },
];

const aboutLinks = [
  { label: "Our Story", href: "#story" },
  { label: "Why Handmade?", href: "#" },
  { label: "Sustainability", href: "#" },
  { label: "Reviews", href: "#" },
];
---

<footer id="contact" class="kn-footer">
  <div class="kn-container">
    <div class="footer-grid">
      <!-- Brand Column -->
      <div class="footer-brand">
        <div class="footer-logo">
          <img
            src={Logo.src}
            alt="Sunflora"
            style="height:40px; width:auto; object-fit:contain; mix-blend-mode:multiply;"
          />
          <div>
            <p class="footer-name">Sunflora</p>
            <p class="footer-tagline">Handmade with love ♡</p>
          </div>
        </div>
        <p class="footer-desc">
          Crochet creations slowly made<br />
          with love — stitched with care,<br />
          shared with a smile ♡
        </p>
        <div class="footer-socials">
          <a href="#" class="social-link" aria-label="Instagram">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"
              ></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
              ></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a href="#" class="social-link" aria-label="Facebook">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
              ></path>
            </svg>
          </a>
          <a href="#" class="social-link" aria-label="Pinterest">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12 0a12 12 0 0 0-4.37 23.17c-.1-.94-.2-2.37.04-3.4l1.39-5.9s-.36-.71-.36-1.76c0-1.64.95-2.87 2.14-2.87 1.01 0 1.5.76 1.5 1.66 0 1.02-.65 2.54-.98 3.95-.28 1.18.59 2.14 1.76 2.14 2.11 0 3.73-2.22 3.73-5.44 0-2.84-2.04-4.83-4.96-4.83-3.38 0-5.36 2.53-5.36 5.15 0 1.02.39 2.11.88 2.71.1.12.11.22.08.34l-.33 1.34c-.05.22-.17.27-.4.16-1.49-.69-2.42-2.87-2.42-4.62 0-3.76 2.73-7.22 7.88-7.22 4.14 0 7.36 2.95 7.36 6.89 0 4.11-2.59 7.42-6.19 7.42-1.21 0-2.35-.63-2.74-1.37l-.74 2.84c-.27 1.04-1 2.35-1.49 3.15A12 12 0 1 0 12 0z"
              ></path>
            </svg>
          </a>
          <a href="#" class="social-link" aria-label="YouTube">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19.13C5.12 19.56 12 19.56 12 19.56s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"
              ></path><polygon
                points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
            </svg>
          </a>
        </div>
      </div>

      <!-- Shop links -->
      <div class="footer-col">
        <h4 class="footer-col-title">Shop</h4>
        {
          shopLinks.map((l) => (
            <a href={l.href} class="footer-link">
              {l.label}
            </a>
          ))
        }
      </div>

      <!-- Customer Care -->
      <div class="footer-col">
        <h4 class="footer-col-title">Customer Care</h4>
        {
          customerLinks.map((l) => (
            <a href={l.href} class="footer-link">
              {l.label}
            </a>
          ))
        }
      </div>

      <!-- About -->
      <div class="footer-col">
        <h4 class="footer-col-title">About</h4>
        {
          aboutLinks.map((l) => (
            <a href={l.href} class="footer-link">
              {l.label}
            </a>
          ))
        }
      </div>

      <!-- Contact -->
      <div class="footer-col">
        <h4 class="footer-col-title">Contact</h4>
        <a href="mailto:hello@sunfloracrochet.in" class="footer-link"
          >📧 hello@sunfloracrochet.in</a
        >
        <a href="tel:+919876543210" class="footer-link">📞 +91-98765-43210</a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p class="footer-copy">© 2025 Sunflora. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .kn-footer {
    background: var(--kn-cream);
    border-top: 1px solid var(--kn-taupe-light);
    padding: 64px 0 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(4, 1fr);
    gap: 40px;
    margin-bottom: 48px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .footer-name {
    font-family: var(--kn-font-heading);
    font-size: 20px;
    font-weight: 700;
    color: var(--kn-brown);
    line-height: 1.1;
  }

  .footer-tagline {
    font-family: var(--kn-font-body);
    font-size: 10px;
    color: var(--kn-brown-muted);
  }

  .footer-desc {
    font-family: var(--kn-font-body);
    font-size: 13px;
    color: var(--kn-brown-light);
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .footer-socials {
    display: flex;
    gap: 10px;
  }

  .social-link {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--kn-taupe);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--kn-brown-light);
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .social-link:hover {
    background: var(--kn-rose);
    border-color: var(--kn-rose);
    color: white;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-col-title {
    font-family: var(--kn-font-body);
    font-size: 14px;
    font-weight: 700;
    color: var(--kn-brown);
    margin-bottom: 8px;
  }

  .footer-link {
    font-family: var(--kn-font-body);
    font-size: 13px;
    color: var(--kn-brown-light);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .footer-link:hover {
    color: var(--kn-rose);
  }

  .footer-bottom {
    border-top: 1px solid var(--kn-taupe-light);
    padding: 20px 0;
    text-align: center;
  }

  .footer-copy {
    font-family: var(--kn-font-body);
    font-size: 12px;
    color: var(--kn-brown-muted);
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .kn-footer {
      padding: 40px 0 0;
    }
  }
</style>
