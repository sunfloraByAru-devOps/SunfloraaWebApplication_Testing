---
/* New Arrivals section — horizontal carousel, right-aligned with veil on left */
const products = [
  {
    name: "Sunflower Tote Bag",
    img: "/images/landing/prod-bag.png",
    price: "₹1,499",
  },
  {
    name: "Rose Bouquet",
    img: "/images/landing/cat-bouquet.png",
    price: "₹699",
  },
  {
    name: "Flower Hair Clips Set",
    img: "/images/landing/prod-hairclips.png",
    price: "₹349",
  },
  {
    name: "Pink Yarn Ball",
    img: "/images/landing/prod-yarn.png",
    price: "₹199",
  },
  {
    name: "Home Decor Set",
    img: "/images/landing/cat-home-decor.png",
    price: "₹1,299",
  },
];
---

<section
  id="new-arrivals"
  class="kn-section"
  style="background: var(--kn-cream);"
>
  <div class="kn-container">
    <!-- Header row — right aligned -->
    <div class="arrivals-header kn-fade-up">
      <a href="/productlist" class="kn-view-all">← View All</a>
      <div>
        <h2 class="kn-section-title" style="text-align:right; margin-bottom:0;">
          Latest Collection
        </h2>
        <p class="kn-section-subtitle-right">
          Fresh off the hook, inspired by the latest trends
        </p>
      </div>
    </div>

    <!-- Carousel with veil on left -->
    <div class="arrivals-carousel-wrap">
      <!-- Gradient veil on left edge with arrow -->
      <div class="arrivals-veil" aria-hidden="true">
        <svg
          class="veil-arrow"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="var(--kn-rose, #D4708F)"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </div>
      <div class="arrivals-carousel" id="arrivals-carousel">
        {
          products.map((p, i) => (
            <div
              class="kn-product-card arrivals-card kn-fade-up"
              style={`transition-delay: ${i * 0.08}s`}
            >
              <div class="arrivals-img-wrap">
                <img src={p.img} alt={p.name} loading="lazy" class="card-img" />
                <span class="new-badge">NEW</span>
                <button
                  class="arrivals-wishlist"
                  aria-label={`Add ${p.name} to wishlist`}
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                  </svg>
                </button>
              </div>
              <div class="card-body">
                <p class="card-title">{p.name}</p>
                <p class="card-price">{p.price}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .arrivals-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 40px;
  }

  /* ── Carousel wrapper — right-aligned, ~80% width ── */
  .arrivals-carousel-wrap {
    position: relative;
    width: 82%;
    margin-left: auto; /* push to the right */
  }

  /* Gradient veil on left edge */
  .arrivals-veil {
    position: absolute;
    top: 0;
    left: -1px;
    width: 80px;
    height: 100%;
    background: linear-gradient(to left, transparent, var(--kn-cream, #fff8f0));
    pointer-events: none;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .arrivals-veil .veil-arrow {
    opacity: 0.7;
    animation: arrowPulseLeft 2s ease-in-out infinite;
  }

  @keyframes arrowPulseLeft {
    0%,
    100% {
      transform: translateX(0);
      opacity: 0.7;
    }
    50% {
      transform: translateX(-4px);
      opacity: 1;
    }
  }

  /* ── Carousel track ── */
  .arrivals-carousel {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 8px;
  }

  .arrivals-carousel::-webkit-scrollbar {
    display: none;
  }

  .arrivals-carousel .arrivals-card {
    flex: 0 0 calc((100% - 40px) / 3); /* 3 cards fill the narrower track */
    scroll-snap-align: end;
    min-width: 0;
  }

  .arrivals-img-wrap {
    position: relative;
    overflow: hidden;
    border-radius: var(--kn-radius-md) var(--kn-radius-md) 0 0;
  }

  .new-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--kn-rose);
    color: white;
    font-family: var(--kn-font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 3px 10px;
    border-radius: var(--kn-radius-full);
  }

  .arrivals-wishlist {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--kn-brown-muted);
    transition: all 0.3s ease;
    opacity: 0;
    transform: translateY(-4px);
  }

  .kn-product-card:hover .arrivals-wishlist {
    opacity: 1;
    transform: translateY(0);
  }

  .arrivals-wishlist:hover {
    color: var(--kn-rose);
    background: white;
  }

  @media (max-width: 640px) {
    .arrivals-carousel-wrap {
      width: 90%;
    }
    .arrivals-carousel .arrivals-card {
      flex: 0 0 calc((100% - 14px) / 2); /* 2 cards on mobile */
    }
    .arrivals-carousel {
      gap: 14px;
    }
    .arrivals-header {
      flex-direction: column-reverse;
      gap: 12px;
      align-items: flex-end;
    }
    .arrivals-veil {
      width: 50px;
    }
    .kn-section-subtitle,
    .kn-section-subtitle-right {
      font-size: 0.8rem;
      margin-top: 2px;
      margin-bottom: 8px;
    }
  }
</style>

<script>
  // Auto-scroll New Arrivals carousel — content moves RIGHT
  // Start scrolled to the far end, then scroll backwards
  (() => {
    const carousel = document.getElementById("arrivals-carousel");
    if (!carousel) return;

    const INTERVAL_MS = 3500;
    let timer: ReturnType<typeof setInterval>;

    // Start scrolled to the far right
    function scrollToEnd() {
      carousel!.scrollLeft = carousel!.scrollWidth - carousel!.clientWidth;
    }
    scrollToEnd();
    window.addEventListener("load", scrollToEnd);

    function getCardWidth(): number {
      const card = carousel!.querySelector(
        ".arrivals-card",
      ) as HTMLElement | null;
      if (!card) return 0;
      const style = getComputedStyle(carousel!);
      const gap = parseFloat(style.gap) || 20;
      return card.offsetWidth + gap;
    }

    function scrollOneRight() {
      const cardW = getCardWidth();
      if (cardW === 0) return;

      if (carousel!.scrollLeft <= 2) {
        carousel!.scrollTo({
          left: carousel!.scrollWidth - carousel!.clientWidth,
          behavior: "smooth",
        });
      } else {
        carousel!.scrollBy({ left: -cardW, behavior: "smooth" });
      }
    }

    function startAutoScroll() {
      stopAutoScroll();
      timer = setInterval(scrollOneRight, INTERVAL_MS);
    }

    function stopAutoScroll() {
      clearInterval(timer);
    }

    carousel.addEventListener("mouseenter", stopAutoScroll);
    carousel.addEventListener("mouseleave", startAutoScroll);
    carousel.addEventListener("touchstart", stopAutoScroll, { passive: true });
    carousel.addEventListener("touchend", () =>
      setTimeout(startAutoScroll, 2000),
    );

    const io = new IntersectionObserver(
      ([entry]) => {
        entry.isIntersecting ? startAutoScroll() : stopAutoScroll();
      },
      { threshold: 0.3 },
    );
    io.observe(carousel);
  })();
</script>
