diff --git a/src/lib/cart.ts b/src/lib/cart.ts
new file mode 100644
index 0000000..0af9ab7
--- /dev/null
+++ b/src/lib/cart.ts
@@ -0,0 +1,88 @@
+// Simple localStorage-backed cart. No cart table in the DB by design —
+// the cart only becomes a real `orders` row once checkout calls create-order.
+
+export interface CartItem {
+  product_id: string;
+  name: string;
+  slug?: string;
+  sku?: string;
+  size_label?: string | null;
+  color_name?: string | null;
+  unit_price: number;
+  unit_mrp?: number;
+  image_url?: string | null;
+  quantity: number;
+}
+
+const CART_KEY = "sunflora_cart_v1";
+
+function safeParse(json: string | null): CartItem[] {
+  if (!json) return [];
+  try {
+    const parsed = JSON.parse(json);
+    return Array.isArray(parsed) ? parsed : [];
+  } catch {
+    return [];
+  }
+}
+
+function lineKey(item: Pick<CartItem, "product_id" | "size_label" | "color_name">) {
+  return `${item.product_id}::${item.size_label || ""}::${item.color_name || ""}`;
+}
+
+export function getCart(): CartItem[] {
+  if (typeof window === "undefined") return [];
+  return safeParse(window.localStorage.getItem(CART_KEY));
+}
+
+function saveCart(items: CartItem[]) {
+  window.localStorage.setItem(CART_KEY, JSON.stringify(items));
+  window.dispatchEvent(new CustomEvent("cart:updated", { detail: { items } }));
+}
+
+export function addToCart(item: CartItem) {
+  const items = getCart();
+  const key = lineKey(item);
+  const existing = items.find((i) => lineKey(i) === key);
+  if (existing) {
+    existing.quantity += item.quantity;
+  } else {
+    items.push(item);
+  }
+  saveCart(items);
+  return items;
+}
+
+export function updateQuantity(
+  item: Pick<CartItem, "product_id" | "size_label" | "color_name">,
+  quantity: number,
+) {
+  let items = getCart();
+  const key = lineKey(item);
+  if (quantity <= 0) {
+    items = items.filter((i) => lineKey(i) !== key);
+  } else {
+    const existing = items.find((i) => lineKey(i) === key);
+    if (existing) existing.quantity = quantity;
+  }
+  saveCart(items);
+  return items;
+}
+
+export function removeFromCart(
+  item: Pick<CartItem, "product_id" | "size_label" | "color_name">,
+) {
+  return updateQuantity(item, 0);
+}
+
+export function clearCart() {
+  saveCart([]);
+}
+
+export function cartCount(): number {
+  return getCart().reduce((sum, i) => sum + i.quantity, 0);
+}
+
+export function cartSubtotal(): number {
+  return getCart().reduce((sum, i) => sum + i.unit_price * i.quantity, 0);
+}
diff --git a/src/pages/account/orders.astro b/src/pages/account/orders.astro
new file mode 100644
index 0000000..8d5c775
--- /dev/null
+++ b/src/pages/account/orders.astro
@@ -0,0 +1,71 @@
+---
+import Layout from "../../layouts/Layout.astro";
+import LandingNav from "../../components/landing/LandingNav.astro";
+---
+
+<Layout title="My Orders — Sunflora Studio" description="View your order history">
+  <LandingNav />
+  <div style="height: 72px; background-color: #FFF8F0;"></div>
+
+  <main class="min-h-[60vh] max-w-3xl mx-auto px-6 py-12">
+    <div class="flex items-center justify-between mb-8">
+      <h1 class="font-serif-display text-3xl text-[#5C3D2E]">My Orders</h1>
+      <button id="logout-btn" class="text-sm text-[#D4708F] underline">Log out</button>
+    </div>
+
+    <div id="signed-out" class="hidden text-center py-16">
+      <p class="text-[#5C3D2E] mb-4">Please log in to see your orders.</p>
+      <a href="/login" class="bg-[#5C3D2E] text-[#FFF8F0] px-6 py-3 rounded-lg">Log In</a>
+    </div>
+
+    <div id="orders-empty" class="hidden text-center py-16">
+      <p class="text-[#5C3D2E]">You haven't placed any orders yet.</p>
+      <a href="/productlist" class="text-[#D4708F] underline text-sm">Browse products</a>
+    </div>
+
+    <div id="orders-list" class="flex flex-col gap-4"></div>
+  </main>
+
+  <script type="module">
+    import { supabase } from "../../lib/supabase.ts";
+
+    function money(n) {
+      return "₹" + (Number(n) || 0).toFixed(2);
+    }
+
+    const { data: sessionData } = await supabase.auth.getSession();
+    if (!sessionData.session) {
+      document.getElementById("signed-out").classList.remove("hidden");
+    } else {
+      const { data: orders } = await supabase
+        .from("orders")
+        .select("id, order_number, status, payment_status, total, created_at")
+        .order("created_at", { ascending: false });
+
+      const list = document.getElementById("orders-list");
+      if (!orders || orders.length === 0) {
+        document.getElementById("orders-empty").classList.remove("hidden");
+      } else {
+        const email = sessionData.session.user.email;
+        list.innerHTML = orders
+          .map(
+            (o) => `
+          <a href="/track-order?order=${encodeURIComponent(o.order_number)}&email=${encodeURIComponent(email)}"
+             class="flex justify-between items-center border border-[#E8D5C4] rounded-lg p-4 hover:bg-[#FFF8F0]">
+            <div>
+              <p class="font-medium text-[#5C3D2E]">${o.order_number}</p>
+              <p class="text-xs text-[#9a8b7a]">${new Date(o.created_at).toLocaleDateString()} · ${o.status} · payment: ${o.payment_status}</p>
+            </div>
+            <span class="text-[#5C3D2E] font-medium">${money(o.total)}</span>
+          </a>`,
+          )
+          .join("");
+      }
+    }
+
+    document.getElementById("logout-btn").addEventListener("click", async () => {
+      await supabase.auth.signOut();
+      window.location.href = "/";
+    });
+  </script>
+</Layout>
diff --git a/src/pages/cart.astro b/src/pages/cart.astro
new file mode 100644
index 0000000..7b778f6
--- /dev/null
+++ b/src/pages/cart.astro
@@ -0,0 +1,113 @@
+---
+import Layout from "../layouts/Layout.astro";
+import LandingNav from "../components/landing/LandingNav.astro";
+---
+
+<Layout title="Your Cart — Sunflora Studio" description="Review your cart">
+  <LandingNav />
+  <div style="height: 72px; background-color: #FFF8F0;"></div>
+
+  <main class="min-h-[60vh] max-w-3xl mx-auto px-6 py-12">
+    <h1 class="font-serif-display text-3xl md:text-4xl mb-8 text-[#5C3D2E]">
+      Your Cart
+    </h1>
+
+    <div id="cart-empty" class="hidden text-center py-20">
+      <p class="text-[#5C3D2E] mb-6">Your cart is empty.</p>
+      <a
+        href="/productlist"
+        class="inline-block bg-[#5C3D2E] text-[#FFF8F0] px-6 py-3 rounded-lg"
+        >Continue Shopping</a
+      >
+    </div>
+
+    <div id="cart-items" class="flex flex-col gap-4"></div>
+
+    <div
+      id="cart-summary"
+      class="hidden mt-8 border-t border-[#E8D5C4] pt-6 flex flex-col gap-3"
+    >
+      <div class="flex justify-between text-[#5C3D2E]">
+        <span>Subtotal</span>
+        <span id="cart-subtotal">₹0.00</span>
+      </div>
+      <p class="text-xs text-[#9a8b7a]">
+        Shipping &amp; final total calculated at checkout. Free shipping over ₹999.
+      </p>
+      <a
+        href="/checkout"
+        class="mt-3 text-center bg-[#D4708F] text-white px-6 py-3 rounded-lg font-medium"
+      >
+        Proceed to Checkout
+      </a>
+    </div>
+  </main>
+
+  <script type="module">
+    import { getCart, updateQuantity, removeFromCart, cartSubtotal } from "../lib/cart.ts";
+
+    function money(n) {
+      return "₹" + (Number(n) || 0).toFixed(2);
+    }
+
+    function render() {
+      const items = getCart();
+      const container = document.getElementById("cart-items");
+      const empty = document.getElementById("cart-empty");
+      const summary = document.getElementById("cart-summary");
+
+      if (items.length === 0) {
+        container.innerHTML = "";
+        empty.classList.remove("hidden");
+        summary.classList.add("hidden");
+        return;
+      }
+      empty.classList.add("hidden");
+      summary.classList.remove("hidden");
+
+      container.innerHTML = items
+        .map(
+          (item, idx) => `
+        <div class="flex gap-4 items-center border border-[#E8D5C4] rounded-lg p-4">
+          <img src="${item.image_url || ""}" alt="${item.name}" class="w-20 h-20 object-cover rounded-md bg-[#FFF8F0]" />
+          <div class="flex-1">
+            <p class="font-medium text-[#5C3D2E]">${item.name}</p>
+            <p class="text-xs text-[#9a8b7a]">${item.size_label || ""}${item.size_label && item.color_name ? " · " : ""}${item.color_name || ""}</p>
+            <p class="text-sm text-[#5C3D2E] mt-1">${money(item.unit_price)}</p>
+          </div>
+          <div class="flex items-center gap-2">
+            <button data-idx="${idx}" class="qty-minus w-8 h-8 border border-[#E8D5C4] rounded">−</button>
+            <span class="w-6 text-center">${item.quantity}</span>
+            <button data-idx="${idx}" class="qty-plus w-8 h-8 border border-[#E8D5C4] rounded">+</button>
+          </div>
+          <button data-idx="${idx}" class="remove-btn text-[#D4708F] text-sm ml-2">Remove</button>
+        </div>
+      `,
+        )
+        .join("");
+
+      document.getElementById("cart-subtotal").textContent = money(cartSubtotal());
+
+      container.querySelectorAll(".qty-minus").forEach((btn) =>
+        btn.addEventListener("click", () => {
+          const item = items[Number(btn.dataset.idx)];
+          updateQuantity(item, item.quantity - 1);
+        }),
+      );
+      container.querySelectorAll(".qty-plus").forEach((btn) =>
+        btn.addEventListener("click", () => {
+          const item = items[Number(btn.dataset.idx)];
+          updateQuantity(item, item.quantity + 1);
+        }),
+      );
+      container.querySelectorAll(".remove-btn").forEach((btn) =>
+        btn.addEventListener("click", () => {
+          removeFromCart(items[Number(btn.dataset.idx)]);
+        }),
+      );
+    }
+
+    render();
+    window.addEventListener("cart:updated", render);
+  </script>
+</Layout>
