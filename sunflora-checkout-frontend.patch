+---
+import Layout from "../layouts/Layout.astro";
+import LandingNav from "../components/landing/LandingNav.astro";
+---
+
+<Layout title="Create Account — Sunflora Studio" description="Create your account">
+  <LandingNav />
+  <div style="height: 72px; background-color: #FFF8F0;"></div>
+
+  <main class="min-h-[60vh] max-w-sm mx-auto px-6 py-16">
+    <h1 class="font-serif-display text-3xl mb-2 text-[#5C3D2E]">Create Account</h1>
+    <p class="text-sm text-[#9a8b7a] mb-6">
+      Use the same email you checked out with as a guest and we'll link your past orders automatically.
+    </p>
+
+    <div id="form-error" class="hidden bg-red-50 text-red-700 text-sm p-3 rounded-lg mb-4"></div>
+    <div id="form-success" class="hidden bg-green-50 text-green-700 text-sm p-3 rounded-lg mb-4"></div>
+
+    <form id="signup-form" class="flex flex-col gap-4">
+      <label class="flex flex-col gap-1 text-sm text-[#5C3D2E]">
+        Full name
+        <input name="full_name" required class="border border-[#E8D5C4] rounded-lg px-3 py-2" />
+      </label>
+      <label class="flex flex-col gap-1 text-sm text-[#5C3D2E]">
+        Email
+        <input name="email" type="email" required class="border border-[#E8D5C4] rounded-lg px-3 py-2" />
+      </label>
+      <label class="flex flex-col gap-1 text-sm text-[#5C3D2E]">
+        Password
+        <input name="password" type="password" required minlength="6" class="border border-[#E8D5C4] rounded-lg px-3 py-2" />
+      </label>
+      <button type="submit" class="bg-[#5C3D2E] text-[#FFF8F0] px-6 py-3 rounded-lg mt-2">
+        Create Account
+      </button>
+    </form>
+
+    <p class="text-sm text-[#9a8b7a] mt-6">
+      Already have an account? <a href="/login" class="text-[#D4708F] underline">Log in</a>
+    </p>
+  </main>
+
+  <script type="module">
+    import { supabase } from "../lib/supabase.ts";
+
+    document.getElementById("signup-form").addEventListener("submit", async (e) => {
+      e.preventDefault();
+      const fd = new FormData(e.target);
+      const errorEl = document.getElementById("form-error");
+      const successEl = document.getElementById("form-success");
+      errorEl.classList.add("hidden");
+      successEl.classList.add("hidden");
+
+      const { data, error } = await supabase.auth.signUp({
+        email: fd.get("email"),
+        password: fd.get("password"),
+        options: { data: { full_name: fd.get("full_name") } },
+      });
+
+      if (error) {
+        errorEl.textContent = error.message;
+        errorEl.classList.remove("hidden");
+        return;
+      }
+
+      if (data.session) {
+        window.location.href = "/account/orders";
+      } else {
+        successEl.textContent =
+          "Account created! Check your email to confirm, then log in.";
+        successEl.classList.remove("hidden");
+        e.target.reset();
+      }
+    });
+  </script>
+</Layout>
diff --git a/src/pages/track-order.astro b/src/pages/track-order.astro
new file mode 100644
index 0000000..0a4a19b
--- /dev/null
+++ b/src/pages/track-order.astro
@@ -0,0 +1,177 @@
+---
+import Layout from "../layouts/Layout.astro";
+import LandingNav from "../components/landing/LandingNav.astro";
+---
+
+<Layout title="Track Your Order — Sunflora Studio" description="Track your order status">
+  <LandingNav />
+  <div style="height: 72px; background-color: #FFF8F0;"></div>
+
+  <main class="min-h-[60vh] max-w-2xl mx-auto px-6 py-12">
+    <h1 class="font-serif-display text-3xl mb-2 text-[#5C3D2E]">Track Your Order</h1>
+    <p class="text-sm text-[#9a8b7a] mb-8">
+      Enter your order number and the email you used at checkout.
+    </p>
+
+    <form id="track-form" class="flex flex-col sm:flex-row gap-3 mb-8">
+      <input
+        id="order-number-input"
+        name="order_number"
+        placeholder="Order number e.g. ORD-A1B2C3D4"
+        required
+        class="flex-1 border border-[#E8D5C4] rounded-lg px-3 py-2"
+      />
+      <input
+        id="email-input"
+        name="email"
+        type="email"
+        placeholder="Email used at checkout"
+        required
+        class="flex-1 border border-[#E8D5C4] rounded-lg px-3 py-2"
+      />
+      <button
+        type="submit"
+        id="track-submit"
+        class="bg-[#5C3D2E] text-[#FFF8F0] px-6 py-2 rounded-lg"
+      >
+        Track
+      </button>
+    </form>
+
+    <div id="track-error" class="hidden bg-red-50 text-red-700 text-sm p-3 rounded-lg mb-4"></div>
+
+    <div id="track-result" class="hidden flex flex-col gap-6"></div>
+  </main>
+
+  <script type="module">
+    import { supabase } from "../lib/supabase.ts";
+
+    const params = new URLSearchParams(window.location.search);
+    if (params.get("order")) document.getElementById("order-number-input").value = params.get("order");
+    if (params.get("email")) document.getElementById("email-input").value = params.get("email");
+
+    function money(n) {
+      return "₹" + (Number(n) || 0).toFixed(2);
+    }
+
+    function renderResult(data) {
+      const el = document.getElementById("track-result");
+      el.classList.remove("hidden");
+
+      const progressPct = Math.max(0, Math.min(100, (data.progress_step / data.total_steps) * 100));
+
+      const historyHtml = (data.history || [])
+        .map(
+          (h) => `
+        <li class="text-sm text-[#5C3D2E]">
+          <strong>${h.label}</strong> — ${new Date(h.at).toLocaleString()}
+          ${h.note ? `<br/><span class="text-[#9a8b7a]">${h.note}</span>` : ""}
+        </li>`,
+        )
+        .join("");
+
+      const retryBtn =
+        data.type === "order" && data.payment_status === "failed"
+          ? `<button id="retry-payment-btn" class="bg-[#D4708F] text-white px-5 py-2 rounded-lg text-sm mt-2">Retry Payment</button>`
+          : "";
+
+      el.innerHTML = `
+        <div class="border border-[#E8D5C4] rounded-xl p-6 bg-[#FFF8F0]">
+          <div class="flex justify-between items-start mb-2">
+            <div>
+              <p class="text-xs text-[#9a8b7a] uppercase tracking-wide">${data.type === "custom_order" ? "Custom Order" : "Order"}</p>
+              <p class="font-serif-display text-xl text-[#5C3D2E]">${data.order_number}</p>
+            </div>
+            ${data.total ? `<p class="text-[#5C3D2E] font-medium">${money(data.total)}</p>` : ""}
+          </div>
+
+          <div class="w-full bg-[#E8D5C4] rounded-full h-2 my-4">
+            <div class="bg-[#D4708F] h-2 rounded-full" style="width:${progressPct}%"></div>
+          </div>
+
+          <p class="font-medium text-[#5C3D2E]">${data.stage_label}</p>
+          <p class="text-sm text-[#9a8b7a] mb-3">${data.stage_description}</p>
+
+          ${data.tracking_number ? `<p class="text-sm text-[#5C3D2E]">Courier: ${data.courier || "—"} · Tracking ID: <strong>${data.tracking_number}</strong></p>` : ""}
+          ${data.tracking_url ? `<a href="${data.tracking_url}" target="_blank" class="text-sm text-[#D4708F] underline">Track shipment →</a>` : ""}
+          ${data.quoted_price ? `<p class="text-sm text-[#5C3D2E] mt-2">Quoted price: <strong>${money(data.quoted_price)}</strong></p>` : ""}
+          ${retryBtn}
+        </div>
+
+        ${
+          data.items
+            ? `<div class="flex flex-col gap-2">
+          <p class="text-sm font-medium text-[#5C3D2E]">Items</p>
+          ${data.items
+            .map(
+              (i) => `
+            <div class="flex justify-between text-sm text-[#5C3D2E]">
+              <span>${i.product_name}${i.size_label ? " (" + i.size_label + ")" : ""} × ${i.quantity}</span>
+              <span>${money(i.unit_price * i.quantity)}</span>
+            </div>`,
+            )
+            .join("")}
+        </div>`
+            : ""
+        }
+
+        ${historyHtml ? `<div><p class="text-sm font-medium text-[#5C3D2E] mb-2">History</p><ul class="flex flex-col gap-2">${historyHtml}</ul></div>` : ""}
+      `;
+
+      document.getElementById("retry-payment-btn")?.addEventListener("click", async (e) => {
+        e.target.disabled = true;
+        e.target.textContent = "Redirecting...";
+        const { data: paytmResult, error } = await supabase.functions.invoke("paytm-initiate", {
+          body: { order_id: data.order_id },
+        });
+        if (error || paytmResult?.error) {
+          alert(paytmResult?.error || "Could not start payment. Please try again.");
+          e.target.disabled = false;
+          e.target.textContent = "Retry Payment";
+          return;
+        }
+        const form = document.createElement("form");
+        form.method = "POST";
+        form.action = paytmResult.action_url;
+        Object.entries(paytmResult.params).forEach(([k, v]) => {
+          const input = document.createElement("input");
+          input.type = "hidden";
+          input.name = k;
+          input.value = String(v);
+          form.appendChild(input);
+        });
+        document.body.appendChild(form);
+        form.submit();
+      });
+    }
+
+    async function track(orderNumber, email) {
+      const errorEl = document.getElementById("track-error");
