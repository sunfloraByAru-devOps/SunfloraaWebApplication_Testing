+        .select("*")
+        .order("is_default", { ascending: false });
+
+      if (addresses && addresses.length > 0) {
+        const wrap = document.getElementById("saved-addresses");
+        wrap.classList.remove("hidden");
+        wrap.innerHTML =
+          `<p class="text-sm text-[#5C3D2E] mb-1">Use a saved address:</p>` +
+          addresses
+            .map(
+              (a, i) => `
+          <label class="flex items-start gap-2 text-sm border border-[#E8D5C4] rounded-lg p-2 cursor-pointer">
+            <input type="radio" name="saved_address" value="${i}" />
+            <span>${a.line1}, ${a.city}, ${a.state} ${a.pincode}</span>
+          </label>`,
+            )
+            .join("");
+
+        wrap.querySelectorAll('input[name="saved_address"]').forEach((radio) => {
+          radio.addEventListener("change", () => {
+            const a = addresses[Number(radio.value)];
+            form.line1.value = a.line1;
+            form.line2.value = a.line2 || "";
+            form.city.value = a.city;
+            form.state.value = a.state;
+            form.pincode.value = a.pincode;
+          });
+        });
+      }
+    });
+
+    function showError(msg) {
+      const el = document.getElementById("checkout-error");
+      el.textContent = msg;
+      el.classList.remove("hidden");
+    }
+
+    document.getElementById("checkout-form").addEventListener("submit", async (e) => {
+      e.preventDefault();
+      const form = e.target;
+      const payBtn = document.getElementById("pay-btn");
+      document.getElementById("checkout-error").classList.add("hidden");
+
+      const items = getCart();
+      if (items.length === 0) {
+        showError("Your cart is empty.");
+        return;
+      }
+
+      payBtn.disabled = true;
+      payBtn.textContent = "Placing order...";
+
+      const fd = new FormData(form);
+      const payload = {
+        items: items.map((i) => ({
+          product_id: i.product_id,
+          size_label: i.size_label,
+          color_name: i.color_name,
+          quantity: i.quantity,
+        })),
+        email: fd.get("email"),
+        phone: fd.get("phone"),
+        name: fd.get("name"),
+        shipping: {
+          line1: fd.get("line1"),
+          line2: fd.get("line2"),
+          city: fd.get("city"),
+          state: fd.get("state"),
+          pincode: fd.get("pincode"),
+          country: "India",
+        },
+        notes: fd.get("notes"),
+        save_address: fd.get("save_address") === "on",
+      };
+
+      try {
+        const { data: orderResult, error: orderErr } = await supabase.functions.invoke(
+          "create-order",
+          { body: payload },
+        );
+        if (orderErr || orderResult?.error) {
+          throw new Error(orderResult?.error || orderErr?.message || "Could not place order");
+        }
+
+        // Remember the order for the confirmation / tracking page
+        sessionStorage.setItem(
+          "sunflora_last_order",
+          JSON.stringify({ order_number: orderResult.order_number, email: orderResult.email }),
+        );
+
+        const { data: paytmResult, error: paytmErr } = await supabase.functions.invoke(
+          "paytm-initiate",
+          { body: { order_id: orderResult.order_id } },
+        );
+        if (paytmErr || paytmResult?.error) {
+          throw new Error(paytmResult?.error || paytmErr?.message || "Could not start payment");
+        }
+
+        clearCart();
+
+        const paytmForm = document.getElementById("paytm-form");
+        paytmForm.action = paytmResult.action_url;
+        paytmForm.innerHTML = Object.entries(paytmResult.params)
+          .map(
+            ([k, v]) =>
+              `<input type="hidden" name="${k}" value="${String(v).replace(/"/g, "&quot;")}" />`,
+          )
+          .join("");
+        paytmForm.submit();
+      } catch (err) {
+        showError(err.message || "Something went wrong. Please try again.");
+        payBtn.disabled = false;
+        payBtn.textContent = "Pay with Paytm";
+      }
+    });
+  </script>
+</Layout>
