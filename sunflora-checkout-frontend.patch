+    import { supabase } from "../lib/supabase.ts";
+
+    const FREE_SHIPPING_THRESHOLD = 999;
+    const FLAT_SHIPPING_FEE = 79;
+
+    function money(n) {
+      return "₹" + (Number(n) || 0).toFixed(2);
+    }
+
+    function renderSummary() {
+      const items = getCart();
+      const list = document.getElementById("summary-items");
